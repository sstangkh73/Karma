        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">ModuleLoader</string>
            <string name="Source"><![CDATA[local ModuleLoader = {}

local function getPriority(moduleTable)
	if typeof(moduleTable.Priority) == "number" then
		return moduleTable.Priority
	end

	return 100
end

local function getName(moduleScript: ModuleScript, moduleTable)
	if typeof(moduleTable.Name) == "string" and moduleTable.Name ~= "" then
		return moduleTable.Name
	end

	return moduleScript.Name
end

local function callLifecycle(record, methodName: string, context)
	local method = record.Module[methodName]
	if typeof(method) ~= "function" then
		return true
	end

	local ok, result = pcall(function()
		return method(record.Module, context)
	end)

	if not ok then
		warn(("[ModuleLoader] %s.%s failed: %s"):format(record.Name, methodName, tostring(result)))
		return false
	end

	return true
end

function ModuleLoader.collect(folder: Instance)
	local records = {}

	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("ModuleScript") then
			local ok, moduleTable = pcall(require, child)
			if not ok then
				warn(("[ModuleLoader] Failed to require %s: %s"):format(child:GetFullName(), tostring(moduleTable)))
			elseif typeof(moduleTable) ~= "table" then
				warn(("[ModuleLoader] %s did not return a table"):format(child:GetFullName()))
			else
				table.insert(records, {
					Instance = child,
					Module = moduleTable,
					Name = getName(child, moduleTable),
					Priority = getPriority(moduleTable),
				})
			end
		end
	end

	table.sort(records, function(left, right)
		if left.Priority == right.Priority then
			return left.Name < right.Name
		end

		return left.Priority < right.Priority
	end)

	return records
end

function ModuleLoader.startFolder(folder: Instance, context)
	context = context or {}
	context.Modules = context.Modules or {}

	local records = ModuleLoader.collect(folder)
	for _, record in ipairs(records) do
		context.Modules[record.Name] = record.Module
	end

	for _, record in ipairs(records) do
		callLifecycle(record, "Init", context)
	end

	for _, record in ipairs(records) do
		callLifecycle(record, "Start", context)
	end

	return {
		Context = context,
		Records = records,
	}
end

return ModuleLoader
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">RemoteGateway</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RemoteGateway = {}

RemoteGateway.DEFAULT_FOLDER_NAME = "GameRemotes"

function RemoteGateway.getOrCreateFolder(folderName: string?, parent: Instance?)
	local root = parent or ReplicatedStorage
	local name = folderName or RemoteGateway.DEFAULT_FOLDER_NAME
	local folder = root:FindFirstChild(name)

	if folder then
		if not folder:IsA("Folder") then
			error(("[RemoteGateway] %s exists but is not a Folder"):format(folder:GetFullName()))
		end

		return folder
	end

	folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = root
	return folder
end

function RemoteGateway.getOrCreateRemote(folderName: string?, remoteName: string, className: string)
	local folder = RemoteGateway.getOrCreateFolder(folderName)
	local remote = folder:FindFirstChild(remoteName)

	if remote then
		if not remote:IsA(className) then
			error(("[RemoteGateway] %s exists but is not a %s"):format(remote:GetFullName(), className))
		end

		return remote
	end

	remote = Instance.new(className)
	remote.Name = remoteName
	remote.Parent = folder
	return remote
end

function RemoteGateway.waitForRemote(folderName: string?, remoteName: string, className: string, timeout: number?)
	local folder = ReplicatedStorage:WaitForChild(folderName or RemoteGateway.DEFAULT_FOLDER_NAME, timeout or 10)
	if not folder then
		return nil
	end

	local remote = folder:WaitForChild(remoteName, timeout or 10)
	if remote and remote:IsA(className) then
		return remote
	end

	return nil
end

function RemoteGateway.validatePayload(payload, schema)
	if typeof(payload) ~= "table" then
		return false, "Payload must be a table"
	end

	for fieldName, expectedType in schema do
		local value = payload[fieldName]
		local isOptional = false

		if typeof(expectedType) == "string" and string.sub(expectedType, 1, 1) == "?" then
			isOptional = true
			expectedType = string.sub(expectedType, 2)
		end

		if value == nil then
			if not isOptional then
				return false, ("Missing field '%s'"):format(fieldName)
			end
		elseif typeof(value) ~= expectedType then
			return false, ("Field '%s' must be %s"):format(fieldName, expectedType)
		end
	end

	return true, nil
end

function RemoteGateway.createRateLimiter(options)
	options = options or {}

	local window = options.Window or 0.25
	local lastByKey = {}

	return function(player: Player, key: string?)
		local now = os.clock()
		local bucketKey = ("%d:%s"):format(player.UserId, key or "default")
		local last = lastByKey[bucketKey]

		if last and now - last < window then
			return false, window - (now - last)
		end

		lastByKey[bucketKey] = now
		return true, 0
	end
end

return RemoteGateway
]]></string>
          </Properties>
        </Item>
