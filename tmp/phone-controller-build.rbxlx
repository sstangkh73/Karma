        </Item>
        <Item class="LocalScript" referent="185001">
          <Properties>
            <string name="Name">FlashlightSystem</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer

local TOOL_NAME = "Flashlight"
local RENDER_STEP_NAME = "FlashlightCameraAim"
local AIM_ATTACHMENT_NAME = "FlashlightCameraAimAttachment"
local PROXY_LIGHT_NAME = "FlashlightCameraAimLight"
local REFRESH_INTERVAL = 0.1

local state = {
	activeTool = nil,
	targets = {},
	connections = {},
	legacyScripts = {},
	isOn = false,
	nextRefreshAt = 0,
	hasLoggedAim = false,
}

local function disconnectAll()
	for _, connection in ipairs(state.connections) do
		connection:Disconnect()
	end

	table.clear(state.connections)
end

local function findAncestorPart(instance: Instance?): BasePart?
	local current = instance

	while current and current ~= Workspace do
		if current:IsA("BasePart") then
			return current
		end

		current = current.Parent
	end

	return nil
end

local function getEquippedFlashlight(): Tool?
	local character = player.Character
	if not character then
		return nil
	end

	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Tool") and child.Name == TOOL_NAME then
			return child
		end
	end

	return nil
end

local function getMuzzleWorldPosition(target): Vector3
	local origin = target.origin
	if origin and origin.Parent then
		if origin:IsA("Attachment") then
			return origin.WorldPosition
		end

		if origin:IsA("BasePart") then
			return origin.Position
		end
	end

	return target.parentPart.CFrame:PointToWorldSpace(target.localPosition)
end

local function createTarget(sourceLight: SpotLight?, origin: Instance, parentPart: BasePart)
	local worldPosition
	if origin:IsA("Attachment") then
		worldPosition = origin.WorldPosition
	else
		worldPosition = parentPart.Position
	end

	local localPosition = parentPart.CFrame:PointToObjectSpace(worldPosition)

	local aimAttachment = Instance.new("Attachment")
	aimAttachment.Name = AIM_ATTACHMENT_NAME
	aimAttachment.CFrame = CFrame.new(localPosition)
	aimAttachment:SetAttribute("FlashlightCameraAimProxy", true)
	aimAttachment.Parent = parentPart

	local proxyLight
	local originalEnabled = true

	if sourceLight then
		originalEnabled = sourceLight.Enabled
		proxyLight = sourceLight:Clone()
		sourceLight.Enabled = false
	else
		proxyLight = Instance.new("SpotLight")
		proxyLight.Angle = 55
		proxyLight.Brightness = 3
		proxyLight.Color = Color3.fromRGB(255, 244, 214)
		proxyLight.Range = 40
		proxyLight.Shadows = true
	end

	proxyLight.Name = PROXY_LIGHT_NAME
	proxyLight.Face = Enum.NormalId.Front
	proxyLight.Enabled = false
	proxyLight:SetAttribute("FlashlightCameraAimProxy", true)
	proxyLight.Parent = aimAttachment

	table.insert(state.targets, {
		sourceLight = sourceLight,
		originalEnabled = originalEnabled,
		origin = origin,
		parentPart = parentPart,
		localPosition = localPosition,
		attachment = aimAttachment,
		proxyLight = proxyLight,
	})

	return originalEnabled
end

local function restoreLegacyScripts()
	for scriptInstance, wasEnabled in pairs(state.legacyScripts) do
		if scriptInstance.Parent then
			scriptInstance.Enabled = wasEnabled
		end
	end

	table.clear(state.legacyScripts)
end

local function clearActiveTool()
	disconnectAll()

	for _, target in ipairs(state.targets) do
		local sourceLight = target.sourceLight
		if sourceLight and sourceLight.Parent then
			sourceLight.Enabled = target.originalEnabled
		end

		local attachment = target.attachment
		if attachment and attachment.Parent then
			attachment:Destroy()
		end
	end

	table.clear(state.targets)
	restoreLegacyScripts()

	state.activeTool = nil
	state.isOn = false
	state.hasLoggedAim = false
end

local function disableLegacyTurnScripts(tool: Tool)
	for _, descendant in ipairs(tool:GetDescendants()) do
		if descendant:IsA("LocalScript") and string.lower(descendant.Name) == "turn" then
			state.legacyScripts[descendant] = descendant.Enabled
			descendant.Enabled = false
		end
	end
end

local function collectSourceLights(tool: Tool): {SpotLight}
	local sourceLights = {}

	for _, descendant in ipairs(tool:GetDescendants()) do
		if descendant:IsA("SpotLight") and descendant:GetAttribute("FlashlightCameraAimProxy") ~= true then
			table.insert(sourceLights, descendant)
		end
	end

	return sourceLights
end

local function bindTool(tool: Tool)
	clearActiveTool()

	state.activeTool = tool
	disableLegacyTurnScripts(tool)

	local anySourceEnabled = false
	local sourceLights = collectSourceLights(tool)

	for _, sourceLight in ipairs(sourceLights) do
		local origin = sourceLight.Parent
		local parentPart = findAncestorPart(origin)

		if origin and parentPart then
			anySourceEnabled = createTarget(sourceLight, origin, parentPart) or anySourceEnabled
		end
	end

	if #state.targets == 0 then
		local handle = tool:FindFirstChild("Handle", true)
		if handle and handle:IsA("BasePart") then
			createTarget(nil, handle, handle)
			anySourceEnabled = true
			warn("[FlashlightSystem] No SpotLight found; using a camera-aimed fallback light")
		else
			warn("[FlashlightSystem] Flashlight has no SpotLight or Handle")
		end
	end

	state.isOn = anySourceEnabled
	for _, target in ipairs(state.targets) do
		target.proxyLight.Enabled = state.isOn
	end

	table.insert(state.connections, tool.Activated:Connect(function()
		state.isOn = not state.isOn

		for _, target in ipairs(state.targets) do
			if target.proxyLight.Parent then
				target.proxyLight.Enabled = state.isOn
			end
		end
	end))

	table.insert(state.connections, tool.AncestryChanged:Connect(function()
		if tool.Parent ~= player.Character then
			clearActiveTool()
		end
	end))
end

local function refreshActiveTool()
	local equippedTool = getEquippedFlashlight()
	if equippedTool ~= state.activeTool then
		if equippedTool then
			bindTool(equippedTool)
		else
			clearActiveTool()
		end
	end
end

local function updateAim()
	local now = os.clock()
	if now >= state.nextRefreshAt then
		state.nextRefreshAt = now + REFRESH_INTERVAL
		refreshActiveTool()
	end

	if not state.activeTool or #state.targets == 0 then
		return
	end

	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end

	local cameraCFrame = camera.CFrame

	for _, target in ipairs(state.targets) do
		local parentPart = target.parentPart
		local attachment = target.attachment
		local proxyLight = target.proxyLight

		if parentPart.Parent and attachment.Parent == parentPart and proxyLight.Parent == attachment then
			local muzzlePosition = getMuzzleWorldPosition(target)
			local desiredWorldCFrame = CFrame.lookAt(
				muzzlePosition,
				muzzlePosition + cameraCFrame.LookVector,
				cameraCFrame.UpVector
			)

			attachment.CFrame = parentPart.CFrame:ToObjectSpace(desiredWorldCFrame)
			proxyLight.Enabled = state.isOn

			if target.sourceLight and target.sourceLight.Parent then
				target.sourceLight.Enabled = false
			end

			if not state.hasLoggedAim then
				local aimDot = attachment.WorldCFrame.LookVector:Dot(cameraCFrame.LookVector)
				print(("[FlashlightSystem] Camera aim active targets=%d dot=%.4f"):format(#state.targets, aimDot))
				state.hasLoggedAim = true
			end
		end
	end
end

RunService:UnbindFromRenderStep(RENDER_STEP_NAME)
RunService:BindToRenderStep(
	RENDER_STEP_NAME,
	Enum.RenderPriority.Camera.Value + 1,
	updateAim
)

script.Destroying:Connect(function()
	RunService:UnbindFromRenderStep(RENDER_STEP_NAME)
	clearActiveTool()
end)

print("[FlashlightSystem] Boot v2")
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="186">
          <Properties>
            <string name="Name">InventorySystem</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

print("[InventorySystem] Boot")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local InventoryShared = Shared:WaitForChild("InventoryShared")
local Config = require(InventoryShared:WaitForChild("Config"))
local GridUtils = require(InventoryShared:WaitForChild("GridUtils"))

local InventoryClient = {
	state = {
		isOpen = false,
		inventory = nil,
		draggingItemId = nil,
		dragRotated = nil,
		dragHover = nil,
		dragAnchor = nil,
		dragGrabOffset = nil,
		isConnected = false,
		pointerPosition = nil,
		pendingHandDragItemId = nil,
		pendingHandDragStart = nil,
		layoutMode = "Default",
	},
	ui = {},
	remotes = {
		stateRemote = nil,
		requestMoveRemote = nil,
		requestRotateRemote = nil,
		requestEquipRemote = nil,
		getStateRemote = nil,
	},
}

local function isPointInside(frame: GuiObject, point: Vector2)
	local position = frame.AbsolutePosition
	local size = frame.AbsoluteSize

	return point.X >= position.X
		and point.X <= (position.X + size.X)
		and point.Y >= position.Y
		and point.Y <= (position.Y + size.Y)
end

local function vector2FromInputPosition(position: Vector3)
	return Vector2.new(position.X, position.Y)
end

function InventoryClient:disableDefaultBackpack()
	local function apply()
		pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		end)
	end

	apply()

	task.spawn(function()
		for _ = 1, 60 do
			if not (self.ui.screenGui and self.ui.screenGui.Parent) then
				return
			end

			apply()
			task.wait(0.1)
		end

		while self.ui.screenGui and self.ui.screenGui.Parent do
			apply()
			task.wait(2)
		end
	end)

	player.CharacterAdded:Connect(function()
		task.defer(apply)
	end)
end

function InventoryClient:getToolbarWidth()
	return Config.UI.HandSlotSize + Config.UI.ToolbarGap + Config.UI.ToggleButtonWidth
end

function InventoryClient:getCellOffset(cellIndex: number)
	local size = Config.UI.CellSize
	local padding = Config.UI.CellPadding
	return (cellIndex - 1) * (size + padding)
end

function InventoryClient:getInventory()
	return self.state.inventory
end

function InventoryClient:isNoteUiOpen()
	local noteGui = playerGui:FindFirstChild("NoteScreenGui")
	return noteGui ~= nil and noteGui:IsA("ScreenGui") and noteGui.Enabled
end

function InventoryClient:getLayoutMode()
	if self:isNoteUiOpen() then
		return "Overlay"
	end

	return "Default"
end

function InventoryClient:updateHudLayout()
	if not self.ui.toolbar or not self.ui.panel then
		return
	end

	local screenPadding = Config.UI.ScreenPadding or 18
	local panelSpacing = Config.UI.PanelSpacing
	local layoutMode = self:getLayoutMode()
	self.state.layoutMode = layoutMode

	if layoutMode == "Overlay" then
		self.ui.toolbar.AnchorPoint = Vector2.new(1, 0)
		self.ui.toolbar.Position = UDim2.new(1, -screenPadding, 0, screenPadding)
		self.ui.panel.AnchorPoint = Vector2.new(1, 0)
		self.ui.panel.Position = UDim2.new(
			1,
			-screenPadding,
			0,
			screenPadding + Config.UI.ToolbarHeight + panelSpacing
		)
		return
	end

	self.ui.toolbar.AnchorPoint = Vector2.new(0.5, 1)
	self.ui.toolbar.Position = UDim2.new(0.5, 0, 1, -Config.UI.BottomMargin)
	self.ui.panel.AnchorPoint = Vector2.new(0, 1)
	self.ui.panel.Position = UDim2.new(
		0.5,
		math.floor(self:getToolbarWidth() / 2) + panelSpacing,
		1,
		-Config.UI.BottomMargin
	)
end

function InventoryClient:isReady()
	return self.state.isConnected
		and self.remotes.stateRemote ~= nil
		and self.remotes.requestMoveRemote ~= nil
		and self.remotes.requestRotateRemote ~= nil
		and self.remotes.requestEquipRemote ~= nil
		and self.remotes.getStateRemote ~= nil
end

function InventoryClient:getItemState(itemId: string)
	local inventory = self:getInventory()
	if not inventory then
		return nil
	end

	return inventory.Items[itemId]
end

function InventoryClient:getHandItemState()
	local inventory = self:getInventory()
	if not inventory or not inventory.HandItemId then
		return nil
	end

	return inventory.Items[inventory.HandItemId]
end

function InventoryClient:getItemDefinition(itemState)
	local inventory = self:getInventory()
	if not inventory then
		return nil
	end

	return inventory.ItemDefinitions[itemState.DefinitionId]
end

function InventoryClient:getFootprint(itemState, forceRotated: boolean?)
	local definition = self:getItemDefinition(itemState)
	if not definition then
		return 1, 1
	end

	local rotated = itemState.Rotated
	if forceRotated ~= nil then
		rotated = forceRotated
	end

	return GridUtils.getFootprint(definition, rotated)
end

function InventoryClient:getDragAnchor()
	return self.state.dragAnchor or Vector2.new(1, 1)
end

function InventoryClient:getDragGrabOffset()
	return self.state.dragGrabOffset or Vector2.zero
end

function InventoryClient:getPointerPosition()
	return self.state.pointerPosition or UserInputService:GetMouseLocation()
end

function InventoryClient:setPointerPosition(position: Vector2?)
	if position then
		self.state.pointerPosition = position
	end
end

function InventoryClient:clearPendingHandDrag()
	self.state.pendingHandDragItemId = nil
	self.state.pendingHandDragStart = nil
end

function InventoryClient:beginPendingHandDrag(position: Vector2)
	local handItem = self:getHandItemState()
	if not self.state.isOpen or not handItem then
		return
	end

	self.state.pendingHandDragItemId = handItem.ItemId
	self.state.pendingHandDragStart = position
	self:setPointerPosition(position)
end

function InventoryClient:maybeStartPendingHandDrag(position: Vector2)
	local itemId = self.state.pendingHandDragItemId
	local startPosition = self.state.pendingHandDragStart
	if not itemId or not startPosition or self.state.draggingItemId then
		return
	end

	if (position - startPosition).Magnitude < (Config.UI.DragStartThreshold or 10) then
		return
	end

	self:clearPendingHandDrag()
	self:startDragging(itemId, startPosition, "Hand")
end

function InventoryClient:getDragDataForItem(itemId: string, mousePosition: Vector2?, source: string?)
	if not mousePosition then
		return Vector2.new(1, 1), Vector2.zero
	end

	local itemState = self:getItemState(itemId)
	if not itemState then
		return Vector2.new(1, 1), Vector2.zero
	end

	local width, height = self:getFootprint(itemState)
	local step = Config.UI.CellSize + Config.UI.CellPadding
	local dragWidth = (width * Config.UI.CellSize) + ((width - 1) * Config.UI.CellPadding)
	local dragHeight = (height * Config.UI.CellSize) + ((height - 1) * Config.UI.CellPadding)
	local frame
	if source == "Inventory" then
		frame = self.ui.itemFrames[itemId]
	elseif source == "Hand" then
		frame = self.ui.handSlotButton
	else
		return Vector2.new(1, 1), Vector2.zero
	end

	if not frame then
		return Vector2.new(1, 1), Vector2.zero
	end

	local frameSize = frame.AbsoluteSize
	local relative = Vector2.new(
		math.clamp(mousePosition.X - frame.AbsolutePosition.X, 0, frameSize.X),
		math.clamp(mousePosition.Y - frame.AbsolutePosition.Y, 0, frameSize.Y)
	)

	if source == "Hand" then
		local normalizedX = frameSize.X > 0 and (relative.X / frameSize.X) or 0.5
		local normalizedY = frameSize.Y > 0 and (relative.Y / frameSize.Y) or 0.5
		local anchorX = math.clamp(math.floor(normalizedX * width) + 1, 1, width)
		local anchorY = math.clamp(math.floor(normalizedY * height) + 1, 1, height)

		return Vector2.new(anchorX, anchorY), Vector2.new(
			math.clamp(normalizedX * dragWidth, 0, dragWidth),
			math.clamp(normalizedY * dragHeight, 0, dragHeight)
		)
	end

	local anchorX = math.clamp(math.floor(relative.X / step) + 1, 1, width)
	local anchorY = math.clamp(math.floor(relative.Y / step) + 1, 1, height)

	return Vector2.new(anchorX, anchorY), relative
end

function InventoryClient:createRoundedStroke(parent: Instance, color: Color3, transparency: number?)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = parent

	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Transparency = transparency or 0
	stroke.Parent = parent
end

function InventoryClient:createUi()
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "InventoryGui"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = Config.UI.DisplayOrder or 900
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.Parent = playerGui

	local root = Instance.new("Frame")
	root.Name = "Root"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundTransparency = 1
	root.Parent = screenGui

	local toolbar = Instance.new("Frame")
	toolbar.Name = "Toolbar"
	toolbar.AnchorPoint = Vector2.new(0.5, 1)
	toolbar.Position = UDim2.new(0.5, 0, 1, -Config.UI.BottomMargin)
	toolbar.Size = UDim2.fromOffset(self:getToolbarWidth(), Config.UI.ToolbarHeight)
	toolbar.BackgroundTransparency = 1
	toolbar.Active = true
	toolbar.Parent = root

	local handSlotButton = Instance.new("TextButton")
	handSlotButton.Name = "HandSlot"
	handSlotButton.Size = UDim2.fromOffset(Config.UI.HandSlotSize, Config.UI.HandSlotSize)
	handSlotButton.Position = UDim2.fromOffset(0, 0)
	handSlotButton.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
	handSlotButton.AutoButtonColor = false
	handSlotButton.Font = Enum.Font.GothamBold
	handSlotButton.TextColor3 = Color3.fromRGB(245, 245, 245)
	handSlotButton.TextSize = 13
	handSlotButton.TextWrapped = true
	handSlotButton.Text = "HAND\nEmpty"
	handSlotButton.ZIndex = 20
	handSlotButton.Parent = toolbar
	self:createRoundedStroke(handSlotButton, Color3.fromRGB(88, 88, 96), 0.2)

	local toggleButton = Instance.new("TextButton")
	toggleButton.Name = "ToggleBag"
	toggleButton.Size = UDim2.fromOffset(Config.UI.ToggleButtonWidth, Config.UI.ToolbarHeight)
	toggleButton.Position = UDim2.fromOffset(Config.UI.HandSlotSize + Config.UI.ToolbarGap, 0)
	toggleButton.BackgroundColor3 = Color3.fromRGB(31, 31, 36)
	toggleButton.AutoButtonColor = false
	toggleButton.Font = Enum.Font.GothamBold
	toggleButton.TextColor3 = Color3.fromRGB(245, 245, 245)
	toggleButton.TextSize = 14
	toggleButton.TextWrapped = true
	toggleButton.Text = "BAG [I]\nOpen Inventory"
	toggleButton.ZIndex = 20
	toggleButton.Parent = toolbar
	self:createRoundedStroke(toggleButton, Color3.fromRGB(94, 94, 104), 0.18)

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0, 1)
	panel.Position = UDim2.new(0.5, math.floor(self:getToolbarWidth() / 2) + Config.UI.PanelSpacing, 1, -Config.UI.BottomMargin)
	panel.Size = UDim2.fromOffset(320, 180)
	panel.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
	panel.BackgroundTransparency = 0.08
	panel.BorderSizePixel = 0
	panel.Visible = false
	panel.Active = true
	panel.ZIndex = 10
	panel.Parent = root
	self:createRoundedStroke(panel, Color3.fromRGB(92, 92, 104), 0.16)

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Position = UDim2.fromOffset(Config.UI.PanelPadding, 12)
	title.Size = UDim2.new(1, -(Config.UI.PanelPadding * 2), 0, 24)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBold
	title.Text = "Inventory  [I]  [R] Rotate"
	title.TextColor3 = Color3.fromRGB(245, 245, 245)
	title.TextSize = 16
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.ZIndex = 11
	title.Parent = panel

	local subtitle = Instance.new("TextLabel")
	subtitle.Name = "Subtitle"
	subtitle.Position = UDim2.fromOffset(Config.UI.PanelPadding, 38)
	subtitle.Size = UDim2.new(1, -(Config.UI.PanelPadding * 2), 0, 30)
	subtitle.BackgroundTransparency = 1
	subtitle.Font = Enum.Font.Gotham
	subtitle.Text = "Drag a Tool into HAND. To switch, store the current one in the bag first."
	subtitle.TextColor3 = Color3.fromRGB(170, 170, 176)
	subtitle.TextSize = 11
	subtitle.TextWrapped = true
	subtitle.TextXAlignment = Enum.TextXAlignment.Left
	subtitle.ZIndex = 11
	subtitle.Parent = panel

	local gridFrame = Instance.new("Frame")
	gridFrame.Name = "Grid"
	gridFrame.BackgroundTransparency = 1
	gridFrame.Position = UDim2.fromOffset(Config.UI.PanelPadding, 74)
	gridFrame.Size = UDim2.fromOffset(0, 0)
	gridFrame.Active = true
	gridFrame.ZIndex = 11
	gridFrame.Parent = panel

	local statusLabel = Instance.new("TextLabel")
	statusLabel.Name = "Status"
	statusLabel.Position = UDim2.fromOffset(Config.UI.PanelPadding, 78)
	statusLabel.Size = UDim2.new(1, -(Config.UI.PanelPadding * 2), 0, 28)
	statusLabel.BackgroundTransparency = 1
	statusLabel.Font = Enum.Font.Gotham
	statusLabel.Text = "Connecting inventory..."
	statusLabel.TextColor3 = Color3.fromRGB(170, 170, 176)
	statusLabel.TextSize = 12
	statusLabel.TextWrapped = true
	statusLabel.TextXAlignment = Enum.TextXAlignment.Left
	statusLabel.ZIndex = 11
	statusLabel.Parent = panel

	local dragLayer = Instance.new("Frame")
	dragLayer.Name = "DragLayer"
	dragLayer.Size = UDim2.fromScale(1, 1)
	dragLayer.BackgroundTransparency = 1
	dragLayer.Active = false
	dragLayer.ZIndex = 30
	dragLayer.Parent = screenGui

	local placementFrame = Instance.new("Frame")
	placementFrame.Name = "PlacementFrame"
	placementFrame.BackgroundColor3 = Color3.fromRGB(76, 188, 120)
	placementFrame.BackgroundTransparency = 0.35
	placementFrame.BorderSizePixel = 0
	placementFrame.Visible = false
	placementFrame.ZIndex = 12
	placementFrame.Parent = gridFrame

	self:createRoundedStroke(placementFrame, Color3.fromRGB(255, 255, 255), 0.55)

	self.ui.screenGui = screenGui
	self.ui.root = root
	self.ui.toolbar = toolbar
	self.ui.handSlotButton = handSlotButton
	self.ui.toggleButton = toggleButton
	self.ui.panel = panel
	self.ui.title = title
	self.ui.subtitle = subtitle
	self.ui.gridFrame = gridFrame
	self.ui.statusLabel = statusLabel
	self.ui.dragLayer = dragLayer
	self.ui.placementFrame = placementFrame
	self.ui.cellFrames = {}
	self.ui.itemFrames = {}
	self.ui.dragFrame = nil
	self:updateHudLayout()

	toggleButton.Activated:Connect(function()
		self:toggle()
	end)

	handSlotButton.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			self:beginPendingHandDrag(vector2FromInputPosition(input.Position))
		end
	end)

	handSlotButton.Activated:Connect(function()
		self:clearPendingHandDrag()

		if self:getHandItemState() then
			self:equipHandSlot()
		end
	end)
end

function InventoryClient:updatePanelLayout()
	local inventory = self:getInventory()
	if not inventory then
		self.ui.statusLabel.Visible = true
		return
	end

	local columns = inventory.Grid.Columns
	local rows = inventory.Grid.Rows
	local cellSize = Config.UI.CellSize
	local padding = Config.UI.CellPadding
	local panelPadding = Config.UI.PanelPadding

	local gridWidth = (columns * cellSize) + ((columns - 1) * padding)
	local gridHeight = (rows * cellSize) + ((rows - 1) * padding)
	local panelWidth = gridWidth + (panelPadding * 2)
	local panelHeight = gridHeight + panelPadding + 70

	self.ui.gridFrame.Position = UDim2.fromOffset(panelPadding, panelHeight - panelPadding - gridHeight)
	self.ui.gridFrame.Size = UDim2.fromOffset(gridWidth, gridHeight)
	self.ui.panel.Size = UDim2.fromOffset(panelWidth, panelHeight)
	self.ui.statusLabel.Visible = false
	self.ui.placementFrame.Visible = false
	self:updateHudLayout()
end

function InventoryClient:clearGrid()
	for _, frame in self.ui.cellFrames do
		frame:Destroy()
	end
	self.ui.cellFrames = {}

	for _, frame in self.ui.itemFrames do
		frame:Destroy()
	end
	self.ui.itemFrames = {}
end

function InventoryClient:createGrid()
	self:clearGrid()
	self:updatePanelLayout()

	local inventory = self:getInventory()
	if not inventory then
		return
	end

	for row = 1, inventory.Grid.Rows do
		for column = 1, inventory.Grid.Columns do
			local cell = Instance.new("Frame")
			cell.Name = string.format("Cell_%d_%d", column, row)
			cell.Size = UDim2.fromOffset(Config.UI.CellSize, Config.UI.CellSize)
			cell.Position = UDim2.fromOffset(self:getCellOffset(column), self:getCellOffset(row))
			cell.BackgroundColor3 = Color3.fromRGB(34, 34, 39)
			cell.BorderSizePixel = 0
			cell.Active = true
			cell.ZIndex = 11
			cell.Parent = self.ui.gridFrame

			local cellCorner = Instance.new("UICorner")
			cellCorner.CornerRadius = UDim.new(0, 8)
			cellCorner.Parent = cell

			self.ui.cellFrames[string.format("%d:%d", column, row)] = cell
		end
	end
end

function InventoryClient:resetPlacementPreview()
	self.ui.placementFrame.Visible = false

	local handStroke = self.ui.handSlotButton:FindFirstChildOfClass("UIStroke")
	if handStroke then
		handStroke.Color = Color3.fromRGB(88, 88, 96)
		handStroke.Transparency = 0.2
		handStroke.Thickness = 1
	end
end

function InventoryClient:updatePlacementPreview(itemState, hover)
	self:resetPlacementPreview()

	if not hover then
		return
	end

	if hover.Target == "Hand" then
		local handStroke = self.ui.handSlotButton:FindFirstChildOfClass("UIStroke")
		if handStroke then
			handStroke.Color = hover.CanPlace and Color3.fromRGB(76, 188, 120) or Color3.fromRGB(212, 79, 79)
			handStroke.Transparency = 0
			handStroke.Thickness = 2
		end
		return
	end

	local inventory = self:getInventory()
	if not inventory then
		return
	end

	local width, height = self:getFootprint(itemState, self.state.dragRotated)
	local maxGridX = math.max(1, inventory.Grid.Columns - width + 1)
	local maxGridY = math.max(1, inventory.Grid.Rows - height + 1)
	local displayGridX = math.clamp(hover.GridX, 1, maxGridX)
	local displayGridY = math.clamp(hover.GridY, 1, maxGridY)

	self.ui.placementFrame.Size = UDim2.fromOffset(
		(width * Config.UI.CellSize) + ((width - 1) * Config.UI.CellPadding),
		(height * Config.UI.CellSize) + ((height - 1) * Config.UI.CellPadding)
	)
	self.ui.placementFrame.Position = UDim2.fromOffset(
		self:getCellOffset(displayGridX),
		self:getCellOffset(displayGridY)
	)
	self.ui.placementFrame.BackgroundColor3 = hover.CanPlace and Color3.fromRGB(76, 188, 120) or Color3.fromRGB(212, 79, 79)
	self.ui.placementFrame.Visible = true
end

function InventoryClient:createInventoryItemFrame(itemId: string, itemState)
	local button = Instance.new("TextButton")
	button.Name = itemId
	button.AutoButtonColor = false
	button.Font = Enum.Font.GothamMedium
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.TextSize = 13
	button.TextWrapped = true
	button.BackgroundColor3 = Color3.fromRGB(96, 122, 242)
	button.BorderSizePixel = 0
	button.ZIndex = 14
	button.Parent = self.ui.gridFrame

	self:createRoundedStroke(button, Color3.fromRGB(255, 255, 255), 0.45)

	button.InputBegan:Connect(function(input)
		if not self.state.isOpen then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		self:startDragging(itemId, vector2FromInputPosition(input.Position), "Inventory")
	end)

	self.ui.itemFrames[itemId] = button
	return button
end

function InventoryClient:createDragFrame(itemState)
	local frame = Instance.new("TextLabel")
	frame.Name = "DragPreview"
	frame.BackgroundColor3 = Color3.fromRGB(76, 188, 120)
	frame.BackgroundTransparency = 0.15
	frame.BorderSizePixel = 0
	frame.Text = itemState.Name
	frame.TextWrapped = true
	frame.Font = Enum.Font.GothamMedium
	frame.TextSize = 13
	frame.TextColor3 = Color3.fromRGB(255, 255, 255)
	frame.ZIndex = 35
	frame.Parent = self.ui.dragLayer

	self:createRoundedStroke(frame, Color3.fromRGB(255, 255, 255), 0.45)

	return frame
end

function InventoryClient:updateInventoryItemFrame(button: TextButton, itemState, drawGridX: number?, drawGridY: number?, drawRotated: boolean?)
	local width, height = self:getFootprint(itemState, drawRotated)
	local gridX = drawGridX or itemState.GridX
	local gridY = drawGridY or itemState.GridY

	button.Size = UDim2.fromOffset(
		(width * Config.UI.CellSize) + ((width - 1) * Config.UI.CellPadding),
		(height * Config.UI.CellSize) + ((height - 1) * Config.UI.CellPadding)
	)
	button.Position = UDim2.fromOffset(self:getCellOffset(gridX), self:getCellOffset(gridY))
	button.Text = itemState.Name
end

function InventoryClient:refreshToolbar()
	local inventory = self:getInventory()
	local handItem = self:getHandItemState()
	local handButton = self.ui.handSlotButton

	if handItem and handItem.ItemId ~= self.state.draggingItemId then
		handButton.Text = string.format("HAND\n%s", handItem.Name)
		handButton.BackgroundColor3 = Color3.fromRGB(84, 120, 208)
	else
		handButton.Text = "HAND\nEmpty"
		handButton.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
	end

	local itemCount = 0
	if inventory then
		for _, itemState in inventory.Items do
			if itemState.Location == "Inventory" then
				itemCount += 1
			end
		end
	end

	self.ui.toggleButton.Text = string.format("BAG [I]\n%d item(s)", itemCount)
	if not self:isReady() then
		self.ui.toggleButton.Text = "BAG [I]\nConnecting..."
	end

	self.ui.panel.Visible = self.state.isOpen
end

function InventoryClient:refreshInventoryItems()
	local inventory = self:getInventory()
	if not inventory then
		return
	end

	for itemId, itemState in inventory.Items do
		if itemState.Location == "Inventory" then
			local button = self.ui.itemFrames[itemId]
			if not button then
				button = self:createInventoryItemFrame(itemId, itemState)
			end

			button.Visible = itemId ~= self.state.draggingItemId
			self:updateInventoryItemFrame(button, itemState)
		end
	end

	for itemId, button in self.ui.itemFrames do
		local itemState = inventory.Items[itemId]
		if itemState == nil or itemState.Location ~= "Inventory" then
			button:Destroy()
			self.ui.itemFrames[itemId] = nil
		end
	end
end

function InventoryClient:buildLocalOccupancy(excludedItemId: string?)
	local occupancy = {}
	local inventory = self:getInventory()
	if not inventory then
		return occupancy
	end

	for itemId, itemState in inventory.Items do
		if itemId ~= excludedItemId and itemState.Location == "Inventory" then
			GridUtils.writeItemToGrid(occupancy, itemId, itemState.GridX, itemState.GridY, itemState.Width, itemState.Height)
		end
	end

	return occupancy
end

function InventoryClient:getHoveredGridPosition(mousePosition: Vector2)
	local gridFrame = self.ui.gridFrame
	local origin = gridFrame.AbsolutePosition
	local relative = mousePosition - origin
	local step = Config.UI.CellSize + Config.UI.CellPadding

	local gridX = math.floor(relative.X / step) + 1
	local gridY = math.floor(relative.Y / step) + 1
	return gridX, gridY
end

function InventoryClient:getPlacementGridPosition(mousePosition: Vector2)
	local rawGridX, rawGridY = self:getHoveredGridPosition(mousePosition)
	local anchor = self:getDragAnchor()

	return rawGridX - math.floor(anchor.X) + 1, rawGridY - math.floor(anchor.Y) + 1
end

function InventoryClient:canMoveToHand(itemState)
	local inventory = self:getInventory()
	local definition = self:getItemDefinition(itemState)
	if not inventory or not definition then
		return false
	end

	if definition.Type ~= "Tool" then
		return false
	end

	return inventory.HandItemId == nil or inventory.HandItemId == itemState.ItemId
end

function InventoryClient:getDragHover(mousePosition: Vector2)
	local itemState = self:getItemState(self.state.draggingItemId)
	local inventory = self:getInventory()
	if not itemState or not inventory then
		return nil
	end

	if isPointInside(self.ui.handSlotButton, mousePosition) then
		return {
			Target = "Hand",
			CanPlace = self:canMoveToHand(itemState),
		}
	end

	if not self.state.isOpen or not isPointInside(self.ui.gridFrame, mousePosition) then
		return nil
	end

	local gridX, gridY = self:getPlacementGridPosition(mousePosition)
	local width, height = self:getFootprint(itemState, self.state.dragRotated)
	local occupancy = self:buildLocalOccupancy(itemState.ItemId)
	local maxGridX = math.max(1, inventory.Grid.Columns - width + 1)
	local maxGridY = math.max(1, inventory.Grid.Rows - height + 1)
	local clampedGridX = math.clamp(gridX, 1, maxGridX)
	local clampedGridY = math.clamp(gridY, 1, maxGridY)

	return {
		Target = "Inventory",
		GridX = clampedGridX,
		GridY = clampedGridY,
		CanPlace = GridUtils.canPlaceItem(
			occupancy,
			inventory.Grid.Columns,
			inventory.Grid.Rows,
			clampedGridX,
			clampedGridY,
			width,
			height
		),
	}
end

function InventoryClient:destroyDragFrame()
	if self.ui.dragFrame then
		self.ui.dragFrame:Destroy()
		self.ui.dragFrame = nil
	end

	self:resetPlacementPreview()
end

function InventoryClient:updateDragPreview()
	local itemState = self:getItemState(self.state.draggingItemId)
	if not itemState then
		self:destroyDragFrame()
		return
	end

	local pointerPosition = self:getPointerPosition()
	if not self.ui.dragFrame then
		self.ui.dragFrame = self:createDragFrame(itemState)
	end

	local dragFrame = self.ui.dragFrame
	local width, height = self:getFootprint(itemState, self.state.dragRotated)
	local dragWidth = (width * Config.UI.CellSize) + ((width - 1) * Config.UI.CellPadding)
	local dragHeight = (height * Config.UI.CellSize) + ((height - 1) * Config.UI.CellPadding)
	local grabOffset = self:getDragGrabOffset()

	dragFrame.Size = UDim2.fromOffset(dragWidth, dragHeight)
	self.state.dragHover = self:getDragHover(pointerPosition)
	self:updatePlacementPreview(itemState, self.state.dragHover)

	if self.state.dragHover and self.state.dragHover.Target == "Inventory" then
		dragFrame.Visible = false
	elseif self.state.dragHover and self.state.dragHover.Target == "Hand" then
		dragFrame.Visible = true
		local handPosition = self.ui.handSlotButton.AbsolutePosition
		local handSize = self.ui.handSlotButton.AbsoluteSize
		dragFrame.Position = UDim2.fromOffset(
			handPosition.X + math.floor((handSize.X - dragWidth) / 2),
			handPosition.Y + math.floor((handSize.Y - dragHeight) / 2)
		)
	else
		dragFrame.Visible = true
		dragFrame.Position = UDim2.fromOffset(pointerPosition.X - grabOffset.X, pointerPosition.Y - grabOffset.Y)
	end

	dragFrame.Text = itemState.Name
	dragFrame.BackgroundColor3 = (self.state.dragHover and self.state.dragHover.CanPlace)
			and Color3.fromRGB(76, 188, 120)
		or Color3.fromRGB(212, 79, 79)
end

function InventoryClient:startDragging(itemId: string, mousePosition: Vector2?, source: string?)
	local itemState = self:getItemState(itemId)
	if not itemState then
		return
	end

	self.state.draggingItemId = itemId
	self.state.dragRotated = itemState.Rotated
	self.state.dragAnchor, self.state.dragGrabOffset = self:getDragDataForItem(itemId, mousePosition, source)
	self.state.dragHover = nil
	self:refreshToolbar()
	self:refreshInventoryItems()
	self:updateDragPreview()
end

function InventoryClient:finishDrag()
	self.state.draggingItemId = nil
	self.state.dragRotated = nil
	self.state.dragHover = nil
	self.state.dragAnchor = nil
	self.state.dragGrabOffset = nil
	self:clearPendingHandDrag()
	self:destroyDragFrame()
	self:refreshToolbar()
	self:refreshInventoryItems()
end

function InventoryClient:commitDrag()
	local itemId = self.state.draggingItemId
	local hover = self.state.dragHover
	if not itemId or not hover or not hover.CanPlace then
		self:finishDrag()
		return
	end

	local payload
	if hover.Target == "Hand" then
		payload = {
			ItemId = itemId,
			Target = "Hand",
			Rotated = self.state.dragRotated == true,
		}
	else
		payload = {
			ItemId = itemId,
			Target = "Inventory",
			GridX = hover.GridX,
			GridY = hover.GridY,
			Rotated = self.state.dragRotated == true,
		}
	end

	self:finishDrag()
	if self.remotes.requestMoveRemote then
		self.remotes.requestMoveRemote:InvokeServer(payload)
	end
end

function InventoryClient:toggle()
	self.state.isOpen = not self.state.isOpen
	self.ui.panel.Visible = self.state.isOpen

	if not self.state.isOpen and self.state.draggingItemId then
		self:finishDrag()
	end

	self:refreshToolbar()
end

function InventoryClient:pulseHandSlot()
	local stroke = self.ui.handSlotButton:FindFirstChildOfClass("UIStroke")
	if not stroke then
		return
	end

	stroke.Color = Color3.fromRGB(255, 230, 120)
	stroke.Thickness = 2
	task.delay(0.18, function()
		if stroke.Parent then
			stroke.Color = Color3.fromRGB(88, 88, 96)
			stroke.Thickness = 1
		end
	end)
end

function InventoryClient:equipHandSlot()
	if self.remotes.requestEquipRemote then
		self.remotes.requestEquipRemote:InvokeServer()
		self:pulseHandSlot()
	end
end

function InventoryClient:rotateDraggedItem()
	local itemState = self:getItemState(self.state.draggingItemId)
	if not itemState or not itemState.Rotatable then
		return
	end

	local currentRotated = self.state.dragRotated == true
	local currentWidth, currentHeight = self:getFootprint(itemState, currentRotated)
	local nextRotated = not currentRotated
	local nextWidth, nextHeight = self:getFootprint(itemState, nextRotated)
	local anchor = self:getDragAnchor()
	local currentGrabOffset = self:getDragGrabOffset()
	local currentPixelWidth = (currentWidth * Config.UI.CellSize) + ((currentWidth - 1) * Config.UI.CellPadding)
	local currentPixelHeight = (currentHeight * Config.UI.CellSize) + ((currentHeight - 1) * Config.UI.CellPadding)
	local nextPixelWidth = (nextWidth * Config.UI.CellSize) + ((nextWidth - 1) * Config.UI.CellPadding)
	local nextPixelHeight = (nextHeight * Config.UI.CellSize) + ((nextHeight - 1) * Config.UI.CellPadding)

	self.state.dragRotated = nextRotated
	self.state.dragAnchor = Vector2.new(
		math.clamp(anchor.Y, 1, nextWidth),
		math.clamp(currentWidth - anchor.X + 1, 1, nextHeight)
	)
	self.state.dragGrabOffset = Vector2.new(
		math.clamp(currentGrabOffset.Y, 0, nextPixelWidth),
		math.clamp(currentPixelWidth - currentGrabOffset.X, 0, nextPixelHeight)
	)
	self:updateDragPreview()
end

function InventoryClient:handleQuickSlotInput()
	if self.state.draggingItemId then
		local itemState = self:getItemState(self.state.draggingItemId)
		if itemState and self:canMoveToHand(itemState) and self.remotes.requestMoveRemote then
			local didMove = self.remotes.requestMoveRemote:InvokeServer({
				ItemId = itemState.ItemId,
				Target = "Hand",
				Rotated = self.state.dragRotated == true,
			})
			self:finishDrag()
			if didMove then
				self:equipHandSlot()
			end
		else
			self:finishDrag()
		end
		return
	end

	local handItem = self:getHandItemState()
	if handItem then
		self:equipHandSlot()
		return
	end

	if not self.state.isOpen then
		return
	end

	local hoveredItemId = self:getHoveredItemId(self:getPointerPosition())
	local hoveredItem = hoveredItemId and self:getItemState(hoveredItemId) or nil
	if hoveredItem and self:canMoveToHand(hoveredItem) and self.remotes.requestMoveRemote then
		local didMove = self.remotes.requestMoveRemote:InvokeServer({
			ItemId = hoveredItem.ItemId,
			Target = "Hand",
			Rotated = hoveredItem.Rotated,
		})
		if didMove then
			self:equipHandSlot()
		end
	end
end

function InventoryClient:getHoveredItemId(mousePosition: Vector2)
	local handItem = self:getHandItemState()
	if handItem and isPointInside(self.ui.handSlotButton, mousePosition) then
		return handItem.ItemId
	end

	if not self.state.isOpen or not isPointInside(self.ui.gridFrame, mousePosition) then
		return nil
	end

	local gridX, gridY = self:getHoveredGridPosition(mousePosition)
	local inventory = self:getInventory()
	if not inventory then
		return nil
	end

	for itemId, itemState in inventory.Items do
		if itemState.Location == "Inventory"
			and gridX >= itemState.GridX
			and gridX < (itemState.GridX + itemState.Width)
			and gridY >= itemState.GridY
			and gridY < (itemState.GridY + itemState.Height)
		then
			return itemId
		end
	end

	return nil
end

function InventoryClient:onInventoryState(newState)
	self.state.inventory = newState
	self:createGrid()
	self:refreshToolbar()
	self:refreshInventoryItems()
end

function InventoryClient:connectRemotes()
	local ok, errorMessage = pcall(function()
		local remotesFolder = ReplicatedStorage:WaitForChild(Config.RemotesFolderName)
		self.remotes.stateRemote = remotesFolder:WaitForChild("State")
		self.remotes.requestMoveRemote = remotesFolder:WaitForChild("RequestMoveItem")
		self.remotes.requestRotateRemote = remotesFolder:WaitForChild("RequestRotateItem")
		self.remotes.requestEquipRemote = remotesFolder:WaitForChild("RequestEquipHandItem")
		self.remotes.getStateRemote = remotesFolder:WaitForChild("GetState")
		self.state.isConnected = true

		self.remotes.stateRemote.OnClientEvent:Connect(function(newState)
			self:onInventoryState(newState)
		end)

		local initialState = self.remotes.getStateRemote:InvokeServer()
		self:onInventoryState(initialState)
		self:refreshToolbar()
	end)

	if not ok then
		self.state.isConnected = false
		if self.ui.statusLabel then
			self.ui.statusLabel.Text = string.format("Inventory failed to connect: %s", tostring(errorMessage))
		end
		self:refreshToolbar()
	end
end

function InventoryClient:bind()
	ContextActionService:BindActionAtPriority(
		"InventoryToggle",
		function(_, inputState)
			if inputState ~= Enum.UserInputState.Begin then
				return Enum.ContextActionResult.Pass
			end

			if UserInputService:GetFocusedTextBox() then
				return Enum.ContextActionResult.Pass
			end

			self:toggle()
			return Enum.ContextActionResult.Sink
		end,
		false,
		Config.UI.InputPriority or Enum.ContextActionPriority.High.Value,
		Config.UI.ToggleKey
	)

	ContextActionService:BindActionAtPriority(
		"InventoryQuickSlot",
		function(_, inputState)
			if inputState ~= Enum.UserInputState.Begin then
				return Enum.ContextActionResult.Pass
			end

			if UserInputService:GetFocusedTextBox() then
				return Enum.ContextActionResult.Pass
			end

			self:handleQuickSlotInput()
			return Enum.ContextActionResult.Sink
		end,
		false,
		Config.UI.InputPriority or Enum.ContextActionPriority.High.Value,
		Config.UI.QuickSlotKey
	)

	ContextActionService:BindActionAtPriority(
		"InventoryRotate",
		function(_, inputState)
			if inputState ~= Enum.UserInputState.Begin then
				return Enum.ContextActionResult.Pass
			end

			if UserInputService:GetFocusedTextBox() then
				return Enum.ContextActionResult.Pass
			end

			if self.state.draggingItemId then
				self:rotateDraggedItem()
				return Enum.ContextActionResult.Sink
			end

			local hoveredItemId = self:getHoveredItemId(self:getPointerPosition())
			if hoveredItemId and self.remotes.requestRotateRemote then
				self.remotes.requestRotateRemote:InvokeServer(hoveredItemId)
				return Enum.ContextActionResult.Sink
			end

			return Enum.ContextActionResult.Pass
		end,
		false,
		Config.UI.InputPriority or Enum.ContextActionPriority.High.Value,
		Config.UI.RotateKey
	)

	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local pointerPosition = vector2FromInputPosition(input.Position)
			self:setPointerPosition(pointerPosition)
			self:maybeStartPendingHandDrag(pointerPosition)
		end
	end)

	UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			self:setPointerPosition(vector2FromInputPosition(input.Position))
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			self:setPointerPosition(vector2FromInputPosition(input.Position))
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if self.state.draggingItemId then
				self:commitDrag()
			else
				self:clearPendingHandDrag()
			end
		end
	end)

	RunService.RenderStepped:Connect(function()
		self:updateHudLayout()

		if self.state.draggingItemId then
			self:updateDragPreview()
		end
	end)
end

function InventoryClient:start()
	self:createUi()
	self:disableDefaultBackpack()
	self:bind()
	self:refreshToolbar()

	task.spawn(function()
		self:connectRemotes()
	end)
end

InventoryClient:start()
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="187">
          <Properties>
            <string name="Name">NoteSystem</string>
            <string name="Source"><![CDATA[-- NoteSystem Client Script
-- ระบบกดอ่านโน้ต 2 ชั้น:
--   ชั้น 1: กระดาษ + รูปลายมือ (กรอบสีกระดาษ)
--   ชั้น 2: พื้นหลังมืดโปร่งแสง + ข้อความสีขาว (แบบเกม horror)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

-- รอ modules
local Shared = ReplicatedStorage:WaitForChild("Shared")
local NoteGui = require(Shared:WaitForChild("NoteGui"))
local NoteData = require(Shared:WaitForChild("NoteData"))

-- สร้าง GUI
local gui = NoteGui.create()

-- State
local isOpen = false
local isAnimating = false -- ป้องกันกดซ้ำระหว่างแอนิเมชัน
local currentLayer = 0 -- 0 = ปิด, 1 = กระดาษลายมือ, 2 = ข้อความบนพื้นมืด
local currentNoteId = nil
local USE_SERVER_INTERACTION_SERVICE = true

-- ========================================
-- แอนิเมชัน
-- ========================================
local function showLayer1(fromOpen: boolean?)
	currentLayer = 1

	-- ซ่อนชั้น 2 ก่อนเสมอ
	gui.TextOverlay.Visible = false

	-- แสดงชั้น 1 (กระดาษ)
	gui.Overlay.Visible = true
	gui.NoteFrame.Visible = true
	gui.ScreenGui.Enabled = true

	if fromOpen then
		-- เปิดใหม่ → เล่นแอนิเมชันเลื่อนขึ้น
		gui.NoteFrame.Position = UDim2.new(0.5, -250, 1.5, 0)
		gui.Overlay.BackgroundTransparency = 1

		local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		TweenService:Create(gui.NoteFrame, tweenInfo, {
			Position = UDim2.new(0.5, -250, 0.5, -325)
		}):Play()
		TweenService:Create(gui.Overlay, TweenInfo.new(0.25), {
			BackgroundTransparency = 0.5
		}):Play()
	else
		-- สลับกลับจากชั้น 2 → แสดงเลยไม่ต้องเลื่อน
		gui.NoteFrame.Position = UDim2.new(0.5, -250, 0.5, -325)
		gui.Overlay.BackgroundTransparency = 0.5
	end
end

local function showLayer2()
	currentLayer = 2

	-- ซ่อนชั้น 1
	gui.Overlay.Visible = false
	gui.NoteFrame.Visible = false

	-- แสดงชั้น 2 (พื้นมืดโปร่งแสง + ข้อความ)
	gui.TextOverlay.Visible = true
	gui.TextOverlay.BackgroundTransparency = 1

	TweenService:Create(gui.TextOverlay, TweenInfo.new(0.3), {
		BackgroundTransparency = 0.25
	}):Play()
end

local function hideAll()
	-- ป้องกันเรียกซ้ำ
	if isAnimating then return end
	isAnimating = true
	isOpen = false -- เซ็ต false ทันทีเพื่อป้องกันกดซ้ำ

	local function finish()
		gui.ScreenGui.Enabled = false
		gui.NoteFrame.Visible = false
		gui.Overlay.Visible = false
		gui.TextOverlay.Visible = false
		currentLayer = 0
		currentNoteId = nil
		isAnimating = false
	end

	if currentLayer == 1 then
		local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		local t1 = TweenService:Create(gui.NoteFrame, tweenInfo, {
			Position = UDim2.new(0.5, -250, 1.5, 0)
		})
		TweenService:Create(gui.Overlay, TweenInfo.new(0.2), {
			BackgroundTransparency = 1
		}):Play()
		t1:Play()
		t1.Completed:Once(finish)
	elseif currentLayer == 2 then
		local t1 = TweenService:Create(gui.TextOverlay, TweenInfo.new(0.25), {
			BackgroundTransparency = 1
		})
		t1:Play()
		t1.Completed:Once(finish)
	else
		finish()
	end
end

-- ========================================
-- เปิดโน้ต
-- ========================================
local function openNote(noteId: string)
	-- ป้องกันเปิดซ้ำระหว่างแอนิเมชัน
	if isOpen or isAnimating then return end

	local noteInfo = NoteData.getNoteById(noteId)
	if not noteInfo then
		warn("[NoteSystem] ไม่พบโน้ต: " .. noteId)
		return
	end

	currentNoteId = noteId
	isOpen = true

	-- ตั้งค่าข้อมูล
	gui.HandwritingLayer.Image = noteInfo.handwritingImage
	gui.TextLabel.Text = noteInfo.typedText
	gui.ToggleButton.Text = "Read Text"

	if noteInfo.title and noteInfo.title ~= "" then
		gui.TitleLabel.Text = noteInfo.title
	else
		gui.TitleLabel.Text = ""
	end

	-- เริ่มที่ชั้น 1 (กระดาษลายมือ) — เปิดใหม่
	showLayer1(true)
end

-- ========================================
-- ปิดโน้ต
-- ========================================
local function closeNote()
	if not isOpen or isAnimating then return end
	hideAll()
end

local function connectInteractionRemote()
	local remotesFolder = ReplicatedStorage:WaitForChild("GameRemotes", 15)
	if not remotesFolder then
		warn("[NoteSystem] GameRemotes was not created; note prompts are server-managed.")
		return
	end

	local interactionEvent = remotesFolder:WaitForChild("InteractionEvent", 15)
	if not interactionEvent or not interactionEvent:IsA("RemoteEvent") then
		warn("[NoteSystem] InteractionEvent was not created; note prompts are server-managed.")
		return
	end

	interactionEvent.OnClientEvent:Connect(function(payload)
		if typeof(payload) ~= "table" then
			return
		end

		if payload.Type == "Note" and typeof(payload.NoteId) == "string" then
			openNote(payload.NoteId)
		end
	end)
end

task.spawn(connectInteractionRemote)

-- ========================================
-- เชื่อมต่อปุ่ม
-- ========================================

-- ชั้น 1: กดปุ่ม "อ่านข้อความ" → ไปชั้น 2
gui.ToggleButton.MouseButton1Click:Connect(function()
	if currentLayer == 1 then
		showLayer2()
	end
end)

-- ชั้น 2: กดปุ่ม "ดูลายมือ" → กลับชั้น 1
gui.BackButton.MouseButton1Click:Connect(function()
	if currentLayer == 2 then
		showLayer1()
	end
end)

-- ปุ่มปิด
gui.CloseButton.MouseButton1Click:Connect(closeNote)
gui.CloseButton2.MouseButton1Click:Connect(closeNote)

-- กด overlay เพื่อปิด (ชั้น 1)
gui.Overlay.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		closeNote()
	end
end)

-- กดพื้นหลังมืดเพื่อปิด (ชั้น 2) — ป้องกันคลิกทะลุไปเกม
gui.TextOverlay.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		-- ปิดเฉพาะเมื่อกดพื้นหลัง ไม่ใช่กดปุ่ม (ปุ่มจะ handle เอง)
		closeNote()
	end
end)

-- กดปุ่มคีย์บอร์ด
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if not isOpen then return end

	-- Q หรือ Escape เพื่อปิด
	if input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.Escape then
		closeNote()
	end

	-- Tab เพื่อสลับชั้น
	if input.KeyCode == Enum.KeyCode.Tab then
		if currentLayer == 1 then
			showLayer2()
		elseif currentLayer == 2 then
			showLayer1()
		end
	end
end)

-- ========================================
-- ค้นหา Part ที่มี NoteId แล้วใส่ ClickDetector
-- ========================================
local function connectNote(part: Part)
	if USE_SERVER_INTERACTION_SERVICE then
		return
	end

	local clickDetector = part:FindFirstChildOfClass("ClickDetector")
	if not clickDetector then
		clickDetector = Instance.new("ClickDetector")
		clickDetector.MaxActivationDistance = 10
		clickDetector.Parent = part
	end

	local proximityPrompt = part:FindFirstChildOfClass("ProximityPrompt")
	if not proximityPrompt then
		proximityPrompt = Instance.new("ProximityPrompt")
		proximityPrompt.ActionText = "Read"
		proximityPrompt.ObjectText = "Note"
		proximityPrompt.KeyboardKeyCode = Enum.KeyCode.E
		proximityPrompt.GamepadKeyCode = Enum.KeyCode.ButtonX
		proximityPrompt.HoldDuration = 0
		proximityPrompt.MaxActivationDistance = 10
		proximityPrompt.RequiresLineOfSight = false
		proximityPrompt.Parent = part
	end

	local noteId = part:GetAttribute("NoteId")
	if noteId then
		clickDetector.MouseClick:Connect(function()
			if not isOpen then
				openNote(noteId)
			end
		end)

		proximityPrompt.Triggered:Connect(function(triggeringPlayer)
			if triggeringPlayer == player and not isOpen then
				openNote(noteId)
			end
		end)
	end
end

for _, obj in pairs(workspace:GetDescendants()) do
	if obj:IsA("BasePart") and obj:GetAttribute("NoteId") then
		connectNote(obj)
	end
end

workspace.DescendantAdded:Connect(function(obj)
	if obj:IsA("BasePart") and obj:GetAttribute("NoteId") then
		task.wait(0.1)
		connectNote(obj)
	end
end)

print("[NoteSystem] ระบบโน้ตพร้อมใช้งาน!")
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="188">
          <Properties>
            <string name="Name">RenderCulling</string>
            <string name="Source"><![CDATA[-- RenderCulling
-- Client-side render budget helper for large/night maps.
-- Roblox already does some frustum/occlusion work internally; this script adds
-- optional distance and behind-camera culling for expensive visible parts.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

local CONFIG = {
	ENABLED = true,
	DEBUG = false,

	-- Part culling can cause visible pop-in on buildings/walls. Keep it off until
	-- the map has NoClientCull tags on important structures.
	CULL_PARTS = false,
	CULL_LIGHTS = false,

	-- Parts farther than this are hidden locally only when CULL_PARTS is true.
	-- Physics/server state is unchanged.
	PART_RENDER_DISTANCE = 520,

	-- Dynamic light culling can make a single important light appear to turn off.
	-- Keep CULL_LIGHTS off unless the map has many redundant decorative lights.
	LIGHT_RENDER_DISTANCE = 180,
	LIGHT_FADE_BUFFER = 20,

	-- Hide objects behind the camera only after this distance to avoid pop-in while turning.
	BEHIND_CAMERA_CULL = true,
	BEHIND_CAMERA_MIN_DISTANCE = 100,
	BEHIND_CAMERA_DOT_LIMIT = -0.2,
	LARGE_PART_NO_BEHIND_CULL_SIZE = 80,

	-- Smaller interval = faster pop-in, more CPU. 0.25-0.5 is a good range.
	UPDATE_INTERVAL = 0.35,
	MAX_ITEMS_PER_STEP = 180,

	NO_CULL_TAG = "NoClientCull",
}

type RenderItem = {
	instance: Instance,
	part: BasePart?,
	light: Light?,
	originalLightEnabled: boolean?,
}

local tracked: { RenderItem } = {}
local trackedByInstance: { [Instance]: RenderItem } = {}
local cursor = 1
local elapsed = 0
local hiddenParts = 0
local disabledLights = 0

local function isCharacterDescendant(instance: Instance): boolean
	local character = LocalPlayer.Character
	return character ~= nil and instance:IsDescendantOf(character)
end

local function shouldIgnore(instance: Instance): boolean
	local currentCamera = Workspace.CurrentCamera
	if currentCamera and instance:IsDescendantOf(currentCamera) then
		return true
	end

	if isCharacterDescendant(instance) then
		return true
	end

	if CollectionService:HasTag(instance, CONFIG.NO_CULL_TAG) then
		return true
	end

	local ancestor = instance.Parent
	while ancestor and ancestor ~= Workspace do
		if CollectionService:HasTag(ancestor, CONFIG.NO_CULL_TAG) then
			return true
		end

		ancestor = ancestor.Parent
	end

	return false
end

local function getWorldPosition(item: RenderItem): Vector3?
	if item.part then
		return item.part.Position
	end

	if item.light and item.light.Parent then
		local parent = item.light.Parent
		if parent:IsA("Attachment") then
			return parent.WorldPosition
		end

		if parent:IsA("BasePart") then
			return parent.Position
		end
	end

	return nil
end

local function getPartDistance(part: BasePart, cameraPosition: Vector3): number
	local localPoint = part.CFrame:PointToObjectSpace(cameraPosition)
	local halfSize = part.Size * 0.5
	local clamped = Vector3.new(
		math.clamp(localPoint.X, -halfSize.X, halfSize.X),
		math.clamp(localPoint.Y, -halfSize.Y, halfSize.Y),
		math.clamp(localPoint.Z, -halfSize.Z, halfSize.Z)
	)
	local closestPoint = part.CFrame:PointToWorldSpace(clamped)

	return (closestPoint - cameraPosition).Magnitude
end

local function shouldCullPosition(position: Vector3, maxDistance: number, cameraCFrame: CFrame): boolean
	local offset = position - cameraCFrame.Position
	local distance = offset.Magnitude

	if distance > maxDistance then
		return true
	end

	if not CONFIG.BEHIND_CAMERA_CULL or distance < CONFIG.BEHIND_CAMERA_MIN_DISTANCE then
		return false
	end

	local direction = offset.Unit
	return cameraCFrame.LookVector:Dot(direction) < CONFIG.BEHIND_CAMERA_DOT_LIMIT
end

local function shouldCullLight(position: Vector3, cameraCFrame: CFrame): boolean
	local offset = position - cameraCFrame.Position
	local distance = offset.Magnitude
	local maxDistance = CONFIG.LIGHT_RENDER_DISTANCE

	if distance > maxDistance + CONFIG.LIGHT_FADE_BUFFER then
		return true
	end

	if distance <= maxDistance then
		return false
	end

	return shouldCullPosition(position, maxDistance, cameraCFrame)
end

local function shouldCullPart(part: BasePart, cameraCFrame: CFrame): boolean
	if getPartDistance(part, cameraCFrame.Position) > CONFIG.PART_RENDER_DISTANCE then
		return true
	end

	if math.max(part.Size.X, part.Size.Y, part.Size.Z) >= CONFIG.LARGE_PART_NO_BEHIND_CULL_SIZE then
		return false
	end

	return shouldCullPosition(part.Position, CONFIG.PART_RENDER_DISTANCE, cameraCFrame)
end

local function setPartHidden(part: BasePart, hidden: boolean)
	local target = if hidden then 1 else 0
	if part.LocalTransparencyModifier ~= target then
		part.LocalTransparencyModifier = target
		hiddenParts += if hidden then 1 else -1
	end
end

local function setLightHidden(item: RenderItem, hidden: boolean)
	local light = item.light
	if not light then
		return
	end

	local enabled = if hidden then false else (item.originalLightEnabled ~= false)
	if light.Enabled ~= enabled then
		light.Enabled = enabled
		disabledLights += if hidden then 1 else -1
	end
end

local function track(instance: Instance)
	if trackedByInstance[instance] or shouldIgnore(instance) then
		return
	end

	local item: RenderItem?
	if CONFIG.CULL_PARTS and instance:IsA("BasePart") then
		item = {
			instance = instance,
			part = instance,
		}
	elseif CONFIG.CULL_LIGHTS and instance:IsA("Light") then
		item = {
			instance = instance,
			light = instance,
			originalLightEnabled = instance.Enabled,
		}
	end

	if not item then
		return
	end

	trackedByInstance[instance] = item
	table.insert(tracked, item)
end

local function untrack(instance: Instance)
	local item = trackedByInstance[instance]
	if not item then
		return
	end

	if item.part then
		item.part.LocalTransparencyModifier = 0
	end

	if item.light then
		item.light.Enabled = item.originalLightEnabled ~= false
	end

	trackedByInstance[instance] = nil
end

local function rebuildTrackedList()
	local compacted = {}
	for _, item in ipairs(tracked) do
		if trackedByInstance[item.instance] and item.instance:IsDescendantOf(Workspace) then
			table.insert(compacted, item)
		end
	end

	tracked = compacted
	if cursor > #tracked then
		cursor = 1
	end
end

for _, descendant in ipairs(Workspace:GetDescendants()) do
	track(descendant)
end

Workspace.DescendantAdded:Connect(track)
Workspace.DescendantRemoving:Connect(untrack)

LocalPlayer.CharacterAdded:Connect(function()
	task.defer(function()
		for _, descendant in ipairs(Workspace:GetDescendants()) do
			if isCharacterDescendant(descendant) then
				untrack(descendant)
			end
		end
	end)
end)

RunService.Heartbeat:Connect(function(deltaTime)
	if not CONFIG.ENABLED then
		return
	end

	elapsed += deltaTime
	if elapsed < CONFIG.UPDATE_INTERVAL then
		return
	end

	elapsed = 0

	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end

	local cameraCFrame = camera.CFrame
	local processed = 0

	while processed < CONFIG.MAX_ITEMS_PER_STEP and #tracked > 0 do
		if cursor > #tracked then
			cursor = 1
			rebuildTrackedList()
		end

		local item = tracked[cursor]
		cursor += 1
		processed += 1

		if item and item.instance:IsDescendantOf(Workspace) and not shouldIgnore(item.instance) then
			local position = getWorldPosition(item)
			if position then
				if item.part then
					setPartHidden(item.part, shouldCullPart(item.part, cameraCFrame))
				elseif item.light then
					setLightHidden(item, shouldCullLight(position, cameraCFrame))
				end
			end
		end
	end

	if CONFIG.DEBUG then
		print(("[RenderCulling] tracked=%d hiddenParts=%d disabledLights=%d"):format(#tracked, hiddenParts, disabledLights))
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="189">
          <Properties>
            <string name="Name">SpawnLoadingScreen</string>
            <string name="Source"><![CDATA[local ContentProvider = game:GetService("ContentProvider")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local INTRO_DELAY = 0.2
local INTER_MESSAGE_GAP = 0.2
local MESSAGE_HOLD_TIME = 1.6

local MESSAGE_FADE_IN_INFO = TweenInfo.new(0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local MESSAGE_FADE_OUT_INFO = TweenInfo.new(0.725, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local PANEL_FADE_OUT_INFO = TweenInfo.new(0.725, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

local PRIMARY_START_POSITION = UDim2.new(0.5, 0, 0.5, 12)
local PRIMARY_VISIBLE_POSITION = UDim2.new(0.5, 0, 0.5, 2)
local PRIMARY_END_POSITION = UDim2.new(0.5, 0, 0.5, -8)

local SECONDARY_START_POSITION = UDim2.new(0.5, 0, 0.5, 72)
local SECONDARY_VISIBLE_POSITION = UDim2.new(0.5, 0, 0.5, 62)
local SECONDARY_END_POSITION = UDim2.new(0.5, 0, 0.5, 52)

local DEFAULT_PRIMARY_MAX_SIZE = 38
local DEFAULT_SECONDARY_MAX_SIZE = 22

local PRELOAD_BATCH_SIZE = 24
local PRELOAD_BATCH_DELAY = 0.03
local PRELOAD_STREAM_DISTANCES = {0, 36, 72}
local PRELOAD_NEAR_RADIUS = 70
local PRELOAD_VIEW_RADIUS = 100
local PRELOAD_GUI_SCAN_TIMEOUT = 1

local GUI_NAME_PATTERNS = {
	"crosshair",
	"stamina",
	"hint",
	"start",
	"begin",
	"play",
}

local SYSTEM_FOLDER_NAMES = {
	"FlashlightSystem",
	"SprintSystem",
	"CrouchSystem",
}

local PRELOADABLE_CLASS_NAMES = {
	Beam = true,
	Decal = true,
	ImageButton = true,
	ImageLabel = true,
	MeshPart = true,
	ParticleEmitter = true,
	Sky = true,
	Sound = true,
	SpecialMesh = true,
	SurfaceAppearance = true,
	Texture = true,
	Trail = true,
	VideoFrame = true,
}

local messageSequence = {
	{
		en = "CONTENT WARNING",
		th = "คำเตือนก่อนเข้าเล่น",
		primaryMaxSize = 32,
		secondaryMaxSize = 20,
	},
	{
		en = "Headphones are recommended for the full experience.",
		th = "แนะนำให้สวมหูฟัง เพื่อสัมผัสประสบการณ์อย่างเต็มรูปแบบ",
	},
	{
		en = "This game contains flashing lights, sudden loud sounds, and a tense atmosphere.",
		th = "ภายในเกมมีแสงกะพริบ เสียงดังฉับพลัน และบรรยากาศกดดัน",
	},
	{
		en = "Player discretion is advised.",
		th = "โปรดใช้วิจารณญาณในการเล่น",
	},
}

local activeSequenceId = 0

local function playTween(instance: Instance, tweenInfo: TweenInfo, properties: {[string]: any})
	local tween = TweenService:Create(instance, tweenInfo, properties)
	tween:Play()
	return tween
end

local function waitForTween(tweenInfo: TweenInfo)
	task.wait(tweenInfo.DelayTime + tweenInfo.Time)
end

local function setAllCoreGuiEnabled(enabled: boolean)
	for _ = 1, 10 do
		local success = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, enabled)
		end)

		if success then
			return
		end

		task.wait(0.1)
	end
end

local function isCurrentSequence(sequenceId: number)
	return sequenceId == activeSequenceId
end

local function isSequenceActive(sequenceId: number, gui)
	if not isCurrentSequence(sequenceId) then
		return false
	end

	if not gui.screenGui.Parent then
		setAllCoreGuiEnabled(true)
		return false
	end

	return true
end

local function createLabel(
	parent: Instance,
	name: string,
	font: Enum.Font,
	textColor: Color3,
	size: UDim2,
	position: UDim2,
	minTextSize: number,
	maxTextSize: number
)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = position
	label.Size = size
	label.BackgroundTransparency = 1
	label.Font = font
	label.TextColor3 = textColor
	label.TextScaled = true
	label.TextTransparency = 1
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.Parent = parent

	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = minTextSize
	constraint.MaxTextSize = maxTextSize
	constraint.Parent = label

	return label, constraint
end

local function buildWarningGui()
	local existingGui = playerGui:FindFirstChild("SpawnLoadingScreenGui")
	if existingGui then
		existingGui:Destroy()
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "SpawnLoadingScreenGui"
	screenGui.IgnoreGuiInset = true
	screenGui.ResetOnSpawn = false
	screenGui.DisplayOrder = 1000
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.Parent = playerGui

	local background = Instance.new("Frame")
	background.Name = "Background"
	background.Size = UDim2.fromScale(1, 1)
	background.BackgroundColor3 = Color3.fromRGB(5, 5, 8)
	background.BorderSizePixel = 0
	background.Parent = screenGui

	local backgroundGradient = Instance.new("UIGradient")
	backgroundGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(12, 12, 18)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(3, 3, 5)),
	})
	backgroundGradient.Rotation = 90
	backgroundGradient.Parent = background

	local vignette = Instance.new("Frame")
	vignette.Name = "Vignette"
	vignette.AnchorPoint = Vector2.new(0.5, 0.5)
	vignette.Position = UDim2.fromScale(0.5, 0.5)
	vignette.Size = UDim2.fromScale(1.15, 1.15)
	vignette.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	vignette.BackgroundTransparency = 0.5
	vignette.BorderSizePixel = 0
	vignette.Parent = background

	local vignetteCorner = Instance.new("UICorner")
	vignetteCorner.CornerRadius = UDim.new(1, 0)
	vignetteCorner.Parent = vignette

	local container = Instance.new("Frame")
	container.Name = "Container"
	container.AnchorPoint = Vector2.new(0.5, 0.5)
	container.Position = UDim2.fromScale(0.5, 0.5)
	container.Size = UDim2.new(0.84, 0, 0, 210)
	container.BackgroundTransparency = 1
	container.Parent = background

	local primaryLabel, primaryConstraint = createLabel(
		container,
		"Primary",
		Enum.Font.GothamMedium,
		Color3.fromRGB(245, 245, 247),
		UDim2.new(1, 0, 0, 82),
		PRIMARY_START_POSITION,
		16,
		DEFAULT_PRIMARY_MAX_SIZE
	)
	primaryLabel.TextYAlignment = Enum.TextYAlignment.Bottom

	local secondaryLabel, secondaryConstraint = createLabel(
		container,
		"Secondary",
		Enum.Font.Gotham,
		Color3.fromRGB(168, 168, 176),
		UDim2.new(1, 0, 0, 48),
		SECONDARY_START_POSITION,
		11,
		DEFAULT_SECONDARY_MAX_SIZE
	)
	secondaryLabel.TextYAlignment = Enum.TextYAlignment.Top

	return {
		screenGui = screenGui,
		background = background,
		vignette = vignette,
		primaryLabel = primaryLabel,
		secondaryLabel = secondaryLabel,
		primaryConstraint = primaryConstraint,
		secondaryConstraint = secondaryConstraint,
	}
end

local function prepareMessage(gui, messageData)
	gui.primaryLabel.Text = messageData.en
	gui.secondaryLabel.Text = messageData.th

	gui.primaryConstraint.MaxTextSize = messageData.primaryMaxSize or DEFAULT_PRIMARY_MAX_SIZE
	gui.secondaryConstraint.MaxTextSize = messageData.secondaryMaxSize or DEFAULT_SECONDARY_MAX_SIZE

	gui.primaryLabel.Position = PRIMARY_START_POSITION
	gui.secondaryLabel.Position = SECONDARY_START_POSITION
	gui.primaryLabel.TextTransparency = 1
	gui.secondaryLabel.TextTransparency = 1
end

local function playMessage(gui, sequenceId: number, messageData, isLastMessage: boolean)
	prepareMessage(gui, messageData)

	playTween(gui.primaryLabel, MESSAGE_FADE_IN_INFO, {
		TextTransparency = 0,
		Position = PRIMARY_VISIBLE_POSITION,
	})
	playTween(gui.secondaryLabel, MESSAGE_FADE_IN_INFO, {
		TextTransparency = 0,
		Position = SECONDARY_VISIBLE_POSITION,
	})
	waitForTween(MESSAGE_FADE_IN_INFO)

	if not isSequenceActive(sequenceId, gui) then
		return false
	end

	task.wait(MESSAGE_HOLD_TIME)

	if not isSequenceActive(sequenceId, gui) then
		return false
	end

	playTween(gui.primaryLabel, MESSAGE_FADE_OUT_INFO, {
		TextTransparency = 1,
		Position = PRIMARY_END_POSITION,
	})
	playTween(gui.secondaryLabel, MESSAGE_FADE_OUT_INFO, {
		TextTransparency = 1,
		Position = SECONDARY_END_POSITION,
	})

	if isLastMessage then
		playTween(gui.background, PANEL_FADE_OUT_INFO, {
			BackgroundTransparency = 1,
		})
		playTween(gui.vignette, PANEL_FADE_OUT_INFO, {
			BackgroundTransparency = 1,
		})
	end

	waitForTween(MESSAGE_FADE_OUT_INFO)
	return isSequenceActive(sequenceId, gui)
end

local function cleanupSequence(sequenceId: number, gui)
	if gui.screenGui.Parent then
		gui.screenGui:Destroy()
	end

	if isCurrentSequence(sequenceId) then
		setAllCoreGuiEnabled(true)
	end
end

local function addPreloadTarget(targets, seen, instance: Instance?)
	if not instance or seen[instance] then
		return
	end

	if not instance.Parent then
		return
	end

	seen[instance] = true
	table.insert(targets, instance)
end

local function collectPreloadableDescendants(root: Instance?, targets, seen)
	if not root then
		return
	end

	if PRELOADABLE_CLASS_NAMES[root.ClassName] then
		addPreloadTarget(targets, seen, root)
	end

	for _, descendant in ipairs(root:GetDescendants()) do
		if PRELOADABLE_CLASS_NAMES[descendant.ClassName] then
			addPreloadTarget(targets, seen, descendant)
		end
	end
end

local function getCharacterRoot(character: Model)
	return character:FindFirstChild("HumanoidRootPart")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
		or character.PrimaryPart
end

local function requestStreamAround(position: Vector3)
	pcall(function()
		player:RequestStreamAroundAsync(position)
	end)
end

local function queryNearbyParts(position: Vector3, radius: number)
	local overlapParams = OverlapParams.new()
	overlapParams.MaxParts = 0
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	overlapParams.FilterDescendantsInstances = {}

	local success, parts = pcall(function()
		return Workspace:GetPartBoundsInRadius(position, radius, overlapParams)
	end)

	if success and parts then
		return parts
	end

	return {}
end

local function collectSpawnAreaTargets(character: Model, targets, seen)
	local rootPart = getCharacterRoot(character)
	if not rootPart then
		return
	end

	local origin = rootPart.Position
	local lookVector = rootPart.CFrame.LookVector

	for _, distance in ipairs(PRELOAD_STREAM_DISTANCES) do
		local samplePosition = origin + (lookVector * distance)
		requestStreamAround(samplePosition)

		for _, part in ipairs(queryNearbyParts(samplePosition, PRELOAD_NEAR_RADIUS)) do
			collectPreloadableDescendants(part, targets, seen)
		end
	end

	for _, part in ipairs(queryNearbyParts(origin, PRELOAD_VIEW_RADIUS)) do
		local toPart = part.Position - origin
		local distance = toPart.Magnitude

		if distance > 0 then
			local facingScore = lookVector:Dot(toPart.Unit)
			if facingScore >= 0.15 then
				collectPreloadableDescendants(part, targets, seen)
			end
		end
	end
end

local function warmLightingState()
	local _ = Lighting.Ambient
	local _ = Lighting.OutdoorAmbient
	local _ = Lighting.GlobalShadows
	local _ = Lighting.Brightness
	local _ = Lighting.FogColor
	local _ = Lighting.FogStart
	local _ = Lighting.FogEnd

	for _, descendant in ipairs(Lighting:GetDescendants()) do
		if descendant:IsA("Atmosphere") then
			local _ = descendant.Density + descendant.Offset + descendant.Haze
		elseif descendant:IsA("ColorCorrectionEffect") then
			local _ = descendant.Brightness + descendant.Contrast + descendant.Saturation
		elseif descendant:IsA("BloomEffect") then
			local _ = descendant.Intensity + descendant.Size
		elseif descendant:IsA("SunRaysEffect") then
			local _ = descendant.Intensity + descendant.Spread
		elseif descendant:IsA("BlurEffect") then
			local _ = descendant.Size
		elseif descendant:IsA("DepthOfFieldEffect") then
			local _ = descendant.FarIntensity + descendant.InFocusRadius
		end
	end
end

local function collectLightingTargets(character: Model, targets, seen)
	warmLightingState()
	collectPreloadableDescendants(Lighting, targets, seen)

	for _, sound in ipairs(SoundService:GetDescendants()) do
		if sound:IsA("Sound") and (sound.Looped or string.find(string.lower(sound.Name), "ambient", 1, true)) then
			addPreloadTarget(targets, seen, sound)
		end
	end

	local rootPart = getCharacterRoot(character)
	if rootPart then
		for _, part in ipairs(queryNearbyParts(rootPart.Position, PRELOAD_NEAR_RADIUS)) do
			for _, descendant in ipairs(part:GetDescendants()) do
				if descendant:IsA("Sound") then
					addPreloadTarget(targets, seen, descendant)
				end
			end
		end
	end

	local sharedFolder = ReplicatedStorage:FindFirstChild("Shared")
	if sharedFolder then
		collectPreloadableDescendants(sharedFolder:FindFirstChild("Phone"), targets, seen)
	end
end

local function primePlayerControls(character: Model)
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 2)
	if humanoid then
		local _ = humanoid.WalkSpeed
		local _ = humanoid.JumpPower
	end

	local camera = Workspace.CurrentCamera
	if camera then
		local _ = camera.CFrame
		local _ = camera.FieldOfView
	end
end

local function collectPlayerSystemTargets(character: Model, targets, seen)
	primePlayerControls(character)

	for _, folderName in ipairs(SYSTEM_FOLDER_NAMES) do
		collectPreloadableDescendants(script.Parent:FindFirstChild(folderName), targets, seen)
	end

	local sharedFolder = ReplicatedStorage:FindFirstChild("Shared")
	if sharedFolder then
		collectPreloadableDescendants(sharedFolder:FindFirstChild("Phone"), targets, seen)
	end
end

local function matchesGuiPattern(name: string)
	local loweredName = string.lower(name)

	for _, pattern in ipairs(GUI_NAME_PATTERNS) do
		if string.find(loweredName, pattern, 1, true) then
			return true
		end
	end

	return false
end

local function collectImportantUiTargets(targets, seen)
	local deadline = os.clock() + PRELOAD_GUI_SCAN_TIMEOUT

	repeat
		for _, descendant in ipairs(playerGui:GetDescendants()) do
			if matchesGuiPattern(descendant.Name) then
				collectPreloadableDescendants(descendant, targets, seen)
				addPreloadTarget(targets, seen, descendant)
			end
		end

		task.wait(0.1)
	until os.clock() >= deadline
end

local function preloadTargets(sequenceId: number, targets)
	local startIndex = 1

	while startIndex <= #targets do
		if not isCurrentSequence(sequenceId) then
			return
		end

		local batch = {}
		local endIndex = math.min(startIndex + PRELOAD_BATCH_SIZE - 1, #targets)

		for index = startIndex, endIndex do
			local instance = targets[index]
			if instance and instance.Parent then
				table.insert(batch, instance)
			end
		end

		if #batch > 0 then
			pcall(function()
				ContentProvider:PreloadAsync(batch)
			end)
		end

		startIndex = endIndex + 1
		task.wait(PRELOAD_BATCH_DELAY)
	end
end

local function runPriorityPreload(sequenceId: number, character: Model)
	local seen = {}

	local mapTargets = {}
	collectSpawnAreaTargets(character, mapTargets, seen)
	preloadTargets(sequenceId, mapTargets)

	if not isCurrentSequence(sequenceId) then
		return
	end

	local lightingTargets = {}
	collectLightingTargets(character, lightingTargets, seen)
	preloadTargets(sequenceId, lightingTargets)

	if not isCurrentSequence(sequenceId) then
		return
	end

	local playerSystemTargets = {}
	collectPlayerSystemTargets(character, playerSystemTargets, seen)
	preloadTargets(sequenceId, playerSystemTargets)

	if not isCurrentSequence(sequenceId) then
		return
	end

	local uiTargets = {}
	collectImportantUiTargets(uiTargets, seen)
	preloadTargets(sequenceId, uiTargets)
end

local function showLoadingScreen(character: Model)
	activeSequenceId += 1
	local sequenceId = activeSequenceId

	setAllCoreGuiEnabled(false)

	local gui = buildWarningGui()

	task.spawn(function()
		runPriorityPreload(sequenceId, character)
	end)

	task.wait(INTRO_DELAY)

	if not isSequenceActive(sequenceId, gui) then
		return
	end

	for index, messageData in ipairs(messageSequence) do
		local isLastMessage = index == #messageSequence
		local completed = playMessage(gui, sequenceId, messageData, isLastMessage)

		if not completed then
			return
		end

		if not isLastMessage then
			task.wait(INTER_MESSAGE_GAP)

			if not isSequenceActive(sequenceId, gui) then
				return
			end
		end
	end

	cleanupSequence(sequenceId, gui)
end

local function onCharacterAdded(character: Model)
	character:WaitForChild("Humanoid", 5)
	task.defer(showLoadingScreen, character)
end

player.CharacterAdded:Connect(onCharacterAdded)

if player.Character then
	onCharacterAdded(player.Character)
end
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="190">
          <Properties>
            <string name="Name">SprintSystem</string>
            <string name="Source"><![CDATA[-- SprintSystem
-- Hold Shift to sprint, drain stamina while sprinting,
-- regenerate stamina when stopping, and hide the bar when full.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local SprintSystem = {}
SprintSystem.RENDER_STEP_NAME = "SprintSystemCameraEffects"

SprintSystem.player = Players.LocalPlayer
SprintSystem.CONFIG = {
	SPRINT_KEY = Enum.KeyCode.LeftShift,
	WALK_SPEED = 14,
	SPRINT_SPEED = 20,
	MAX_STAMINA = 100,
	DRAIN_RATE = 20,
	REGEN_RATE = 15,
	STATIONARY_REGEN_MULTIPLIER = 1.3,
	EXHAUSTED_UNLOCK_RATIO = 0.5,
	POST_UNLOCK_REGEN_MULTIPLIER = 0.7,
	LOW_STAMINA_COLOR_START_RATIO = 0.5,
	HIGH_STAMINA_COLOR = Color3.new(1, 1, 1),
	LOW_STAMINA_COLOR = Color3.fromRGB(255, 0, 0),
	BAR_HEIGHT = 3,
	BAR_FADE_TIME = 0.2,
	MOVE_THRESHOLD = 0.1,
	SPRINT_FOV_BOOST = 5,
	FOV_TWEEN_TIME = 0.18,
	CAMERA_SHAKE = {
		LOW_STAMINA_START_RATIO = 0.25,
		MAX_PITCH_DEGREES = 0.18,
		MAX_ROLL_DEGREES = 0.3,
		PITCH_FREQUENCY = 18,
		ROLL_FREQUENCY = 24,
	},
	SOUND = {
		ENABLED = false,
		MASTER_VOLUME = 1,
		PLAYBACK_SPEED = 1,
		SPRINT_LOOP = {
			SOUND_ID = "",
			VOLUME = 0.3,
			LOOPED = true,
		},
		LOW_STAMINA_LOOP = {
			SOUND_ID = "",
			VOLUME = 0.25,
			LOOPED = true,
		},
		EXHAUSTED = {
			SOUND_ID = "",
			VOLUME = 0.4,
			LOOPED = false,
		},
	},
}

SprintSystem.state = {
	stamina = SprintSystem.CONFIG.MAX_STAMINA,
	isSprinting = false,
	shiftHeld = false,
	isExhausted = false,
	barShowing = false,
	fadeTween = nil,
	fieldOfViewTween = nil,
	defaultFieldOfView = nil,
	currentFovTarget = nil,
	activeCamera = nil,
	isSprintFovApplied = false,
	cameraShakeTime = 0,
	wasExhausted = false,
}

SprintSystem.ui = {}
SprintSystem.audio = {
	folder = nil,
	sounds = {},
}

function SprintSystem:createUi()
	local playerGui = self.player:WaitForChild("PlayerGui")

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "SprintBarGui"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 50
	screenGui.Parent = playerGui

	local barBg = Instance.new("CanvasGroup")
	barBg.Name = "StaminaBarBg"
	barBg.Size = UDim2.new(1, 0, 0, self.CONFIG.BAR_HEIGHT)
	barBg.Position = UDim2.new(0, 0, 1, -self.CONFIG.BAR_HEIGHT)
	barBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	barBg.BackgroundTransparency = 0.6
	barBg.BorderSizePixel = 0
	barBg.ZIndex = 90
	barBg.GroupTransparency = 1
	barBg.Parent = screenGui

	local barFill = Instance.new("Frame")
	barFill.Name = "StaminaBarFill"
	barFill.Size = UDim2.new(1, 0, 1, 0)
	barFill.Position = UDim2.new(0, 0, 0, 0)
	barFill.BackgroundColor3 = self.CONFIG.HIGH_STAMINA_COLOR
	barFill.BackgroundTransparency = 0.1
	barFill.BorderSizePixel = 0
	barFill.ZIndex = 91
	barFill.Parent = barBg

	self.ui.screenGui = screenGui
	self.ui.barBg = barBg
	self.ui.barFill = barFill
end

function SprintSystem:getCamera(): Camera?
	return workspace.CurrentCamera
end

function SprintSystem:createSound(name: string, soundConfig)
	if not self.CONFIG.SOUND.ENABLED then
		return nil
	end

	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = soundConfig.SOUND_ID or ""
	sound.Looped = soundConfig.LOOPED == true
	sound.Volume = (soundConfig.VOLUME or 1) * self.CONFIG.SOUND.MASTER_VOLUME
	sound.PlaybackSpeed = soundConfig.PLAYBACK_SPEED or self.CONFIG.SOUND.PLAYBACK_SPEED
	sound.Parent = self.audio.folder
	return sound
end

function SprintSystem:createAudio()
	if not self.CONFIG.SOUND.ENABLED then
		return
	end

	local folder = Instance.new("Folder")
	folder.Name = "SprintSystemAudio"
	folder.Parent = SoundService

	self.audio.folder = folder
	self.audio.sounds.sprintLoop = self:createSound("SprintLoop", self.CONFIG.SOUND.SPRINT_LOOP)
	self.audio.sounds.lowStaminaLoop = self:createSound("LowStaminaLoop", self.CONFIG.SOUND.LOW_STAMINA_LOOP)
	self.audio.sounds.exhausted = self:createSound("Exhausted", self.CONFIG.SOUND.EXHAUSTED)
end

function SprintSystem:getUnlockStamina(): number
	return self.CONFIG.MAX_STAMINA * self.CONFIG.EXHAUSTED_UNLOCK_RATIO
end

function SprintSystem:setWalkSpeed(humanoid: Humanoid, speed: number)
	if humanoid.WalkSpeed ~= speed then
		humanoid.WalkSpeed = speed
	end
end

function SprintSystem:setBarShown(shouldShow: boolean, instant: boolean?)
	if self.state.barShowing == shouldShow and not instant then
		return
	end

	self.state.barShowing = shouldShow

	if self.state.fadeTween then
		self.state.fadeTween:Cancel()
		self.state.fadeTween = nil
	end

	local targetTransparency = shouldShow and 0 or 1
	if instant then
		self.ui.barBg.GroupTransparency = targetTransparency
		return
	end

	local tween = TweenService:Create(self.ui.barBg, TweenInfo.new(self.CONFIG.BAR_FADE_TIME), {
		GroupTransparency = targetTransparency,
	})
	self.state.fadeTween = tween
	tween.Completed:Once(function()
		if self.state.fadeTween == tween then
			self.state.fadeTween = nil
		end
	end)
	tween:Play()
end

function SprintSystem:showBar()
	self:setBarShown(true)
end

function SprintSystem:hideBar(instant: boolean?)
	self:setBarShown(false, instant)
end

function SprintSystem:getBarColor(ratio: number): Color3
	if ratio > self.CONFIG.LOW_STAMINA_COLOR_START_RATIO then
		return self.CONFIG.HIGH_STAMINA_COLOR
	end

	local colorT = math.clamp(ratio / self.CONFIG.LOW_STAMINA_COLOR_START_RATIO, 0, 1)
	return self.CONFIG.LOW_STAMINA_COLOR:Lerp(self.CONFIG.HIGH_STAMINA_COLOR, colorT)
end

function SprintSystem:getRegenRate(ratio: number, isMoving: boolean): number
	local regenRate = self.CONFIG.REGEN_RATE

	if not isMoving then
		regenRate *= self.CONFIG.STATIONARY_REGEN_MULTIPLIER
	end

	if ratio >= self.CONFIG.EXHAUSTED_UNLOCK_RATIO then
		regenRate *= self.CONFIG.POST_UNLOCK_REGEN_MULTIPLIER
	end

	return regenRate
end

function SprintSystem:getCameraShakeAlpha(): number
	local staminaRatio = self.state.stamina / self.CONFIG.MAX_STAMINA
	local shakeStartRatio = self.CONFIG.CAMERA_SHAKE.LOW_STAMINA_START_RATIO

	if not self.state.isSprinting or staminaRatio > shakeStartRatio then
		return 0
	end

	return math.clamp((shakeStartRatio - staminaRatio) / shakeStartRatio, 0, 1)
end

function SprintSystem:updateCameraEffects(dt: number)
	local camera = self:getCamera()
	if not camera then
		return
	end

	local shakeAlpha = self:getCameraShakeAlpha()
	if shakeAlpha <= 0 then
		self.state.cameraShakeTime = 0
		return
	end

	self.state.cameraShakeTime += dt

	local pitch = math.rad(
		math.sin(self.state.cameraShakeTime * self.CONFIG.CAMERA_SHAKE.PITCH_FREQUENCY)
			* self.CONFIG.CAMERA_SHAKE.MAX_PITCH_DEGREES
			* shakeAlpha
	)
	local roll = math.rad(
		math.cos(self.state.cameraShakeTime * self.CONFIG.CAMERA_SHAKE.ROLL_FREQUENCY)
			* self.CONFIG.CAMERA_SHAKE.MAX_ROLL_DEGREES
			* shakeAlpha
	)

	camera.CFrame = camera.CFrame * CFrame.Angles(pitch, 0, roll)
end

function SprintSystem:playSound(sound: Sound?, restart: boolean?)
	if not sound or sound.SoundId == "" then
		return
	end

	if restart then
		sound:Stop()
		sound.TimePosition = 0
	end

	if not sound.IsPlaying then
		sound:Play()
	end
end

function SprintSystem:stopSound(sound: Sound?)
	if sound and sound.IsPlaying then
		sound:Stop()
	end
end

function SprintSystem:updateAudio(staminaRatio: number)
	if not self.CONFIG.SOUND.ENABLED then
		self.state.wasExhausted = self.state.isExhausted
		return
	end

	local sprintLoop = self.audio.sounds.sprintLoop
	local lowStaminaLoop = self.audio.sounds.lowStaminaLoop
	local exhaustedSound = self.audio.sounds.exhausted

	if self.state.isSprinting then
		self:playSound(sprintLoop)
	else
		self:stopSound(sprintLoop)
	end

	if self.state.isSprinting and staminaRatio <= self.CONFIG.CAMERA_SHAKE.LOW_STAMINA_START_RATIO then
		self:playSound(lowStaminaLoop)
	else
		self:stopSound(lowStaminaLoop)
	end

	if self.state.isExhausted and not self.state.wasExhausted then
		self:playSound(exhaustedSound, true)
	end

	self.state.wasExhausted = self.state.isExhausted
end

function SprintSystem:setSprintFieldOfView(shouldUseSprintFov: boolean, instant: boolean?)
	local camera = self:getCamera()
	if not camera then
		return
	end

	if camera ~= self.state.activeCamera then
		self.state.activeCamera = camera
		self.state.defaultFieldOfView = camera.FieldOfView
		self.state.currentFovTarget = nil
		self.state.isSprintFovApplied = false
	end

	-- Only refresh the baseline FOV while fully at rest.
	-- If we update it during the return tween, the boosted value can become the new baseline.
	if not shouldUseSprintFov and not self.state.isSprintFovApplied and not self.state.fieldOfViewTween then
		self.state.defaultFieldOfView = camera.FieldOfView
	end

	local baseFieldOfView = self.state.defaultFieldOfView or camera.FieldOfView
	local targetFov = shouldUseSprintFov and (baseFieldOfView + self.CONFIG.SPRINT_FOV_BOOST) or baseFieldOfView

	if self.state.currentFovTarget == targetFov and not instant then
		return
	end

	self.state.currentFovTarget = targetFov
	self.state.isSprintFovApplied = shouldUseSprintFov

	if self.state.fieldOfViewTween then
		self.state.fieldOfViewTween:Cancel()
		self.state.fieldOfViewTween = nil
	end

	if instant then
		camera.FieldOfView = targetFov
		if not shouldUseSprintFov then
			self.state.defaultFieldOfView = targetFov
		end
		return
	end

	local tween = TweenService:Create(camera, TweenInfo.new(self.CONFIG.FOV_TWEEN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		FieldOfView = targetFov,
	})
	self.state.fieldOfViewTween = tween
	tween.Completed:Once(function(playbackState)
		if self.state.fieldOfViewTween == tween then
			self.state.fieldOfViewTween = nil
		end

		if playbackState == Enum.PlaybackState.Completed and not shouldUseSprintFov and self.state.currentFovTarget == targetFov then
			self.state.defaultFieldOfView = camera.FieldOfView
		end
	end)
	tween:Play()
end

function SprintSystem:updateUi()
	local ratio = math.clamp(self.state.stamina / self.CONFIG.MAX_STAMINA, 0, 1)
	self.ui.barFill.Size = UDim2.new(ratio, 0, 1, 0)
	self.ui.barFill.BackgroundColor3 = self:getBarColor(ratio)

	if self.state.isSprinting then
		self:showBar()
	else
		self:hideBar()
	end
end

function SprintSystem:resetState()
	self.state.stamina = self.CONFIG.MAX_STAMINA
	self.state.isSprinting = false
	self.state.shiftHeld = false
	self.state.isExhausted = false
	self.state.defaultFieldOfView = nil
	self.state.currentFovTarget = nil
	self.state.activeCamera = nil
	self.state.isSprintFovApplied = false
	self.state.cameraShakeTime = 0
	self.state.wasExhausted = false
	self:updateUi()
	self:hideBar(true)
	self:setSprintFieldOfView(false, true)
	self:updateAudio(1)
end

function SprintSystem:onInputBegan(input: InputObject, gameProcessed: boolean)
	if gameProcessed then
		return
	end

	if input.KeyCode == self.CONFIG.SPRINT_KEY then
		self.state.shiftHeld = true
	end
end

function SprintSystem:onInputEnded(input: InputObject)
	if input.KeyCode == self.CONFIG.SPRINT_KEY then
		self.state.shiftHeld = false
	end
end

function SprintSystem:update(dt: number)
	local character = self.player.Character
	if not character then
		self.state.isSprinting = false
		self:updateUi()
		self:setSprintFieldOfView(false)
		self:updateAudio(math.clamp(self.state.stamina / self.CONFIG.MAX_STAMINA, 0, 1))
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		self.state.isSprinting = false
		self:updateUi()
		self:setSprintFieldOfView(false)
		self:updateAudio(math.clamp(self.state.stamina / self.CONFIG.MAX_STAMINA, 0, 1))
		return
	end

	local isMoving = humanoid.MoveDirection.Magnitude > self.CONFIG.MOVE_THRESHOLD
	local unlockStamina = self:getUnlockStamina()

	if self.state.isExhausted and self.state.stamina >= unlockStamina then
		self.state.isExhausted = false
	end

	local canSprint = self.state.stamina > 0 and not self.state.isExhausted
	local wantSprint = self.state.shiftHeld and isMoving and canSprint

	if wantSprint then
		self.state.isSprinting = true
		self:setWalkSpeed(humanoid, self.CONFIG.SPRINT_SPEED)
		self.state.stamina = math.max(0, self.state.stamina - (self.CONFIG.DRAIN_RATE * dt))

		if self.state.stamina <= 0 then
			self.state.isExhausted = true
			self.state.isSprinting = false
			self:setWalkSpeed(humanoid, self.CONFIG.WALK_SPEED)
		end
	else
		if self.state.isSprinting then
			self:setWalkSpeed(humanoid, self.CONFIG.WALK_SPEED)
		end
		self.state.isSprinting = false

		if self.state.stamina < self.CONFIG.MAX_STAMINA then
			local staminaRatio = self.state.stamina / self.CONFIG.MAX_STAMINA
			local regenRate = self:getRegenRate(staminaRatio, isMoving)
			self.state.stamina = math.min(self.CONFIG.MAX_STAMINA, self.state.stamina + (regenRate * dt))
		end
	end

	local staminaRatio = math.clamp(self.state.stamina / self.CONFIG.MAX_STAMINA, 0, 1)
	self:updateUi()
	self:setSprintFieldOfView(self.state.isSprinting)
	self:updateAudio(staminaRatio)
end

function SprintSystem:bind()
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		self:onInputBegan(input, gameProcessed)
	end)

	UserInputService.InputEnded:Connect(function(input)
		self:onInputEnded(input)
	end)

	RunService.Heartbeat:Connect(function(dt)
		self:update(dt)
	end)

	RunService:UnbindToRenderStep(self.RENDER_STEP_NAME)
	RunService:BindToRenderStep(self.RENDER_STEP_NAME, Enum.RenderPriority.Camera.Value + 1, function(dt)
		self:updateCameraEffects(dt)
	end)

	self.player.CharacterAdded:Connect(function()
		self:resetState()
	end)
end

function SprintSystem:start()
	self:createUi()
	self:createAudio()
	self:resetState()
	self:bind()
	print("[SprintSystem] Ready - hold Shift to sprint")
end

SprintSystem:start()
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
